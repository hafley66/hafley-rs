set shell := ["bash", "-euo", "pipefail", "-c"]

# Install the pinned contract toolchain from the local registry and npm cache.
contracts-setup:
    pnpm --dir contracts install --frozen-lockfile

# Generate contracts. Full logs stay in .workflow/; stdout is a JSON receipt.
tsp:
    @node 100_workflow.mjs tsp

generate: tsp

status:
    @node 100_workflow.mjs status

# Suites: all, core, godot, workflow, web. Web includes export and browser tests.
test suite="all":
    @node 100_workflow.mjs test {{quote(suite)}}

# Build and record once, with a source-bound artifact receipt.
prove:
    @node 100_workflow.mjs prove

# Publish the proved artifact; refuses stale source or changed artifacts.
deploy:
    @node 100_workflow.mjs deploy

check-generated:
    node contracts/1_generate.mjs --check

test-godot: check-generated
    godot --headless --path godot --script res://1_rows_test.gd
    godot --headless --path godot --script res://1_payload.test.gd

# Rust library and controller checks.
_test-core: check-generated
    just test-reuse
    node 97a_sources.mjs
    node --test contracts/1_generate.test.mjs
    lab_dir="$PWD"; . ./0_shell.sh; lab_cargo test --features gdext --lib -- --test-threads=1
    python3 75_udp_lab.test.py
    python3 84_live_controller.test.py

# Existing reducer algebra, deterministic pools, and shared rollback library.
test-reuse:
    lab_dir="$PWD"; . ./0_shell.sh; CARGO_TARGET_DIR="$lab_dir/target" lab_cargo_manifest "$lab_dir/../../shared/redux/Cargo.toml" test --features serde
    lab_dir="$PWD"; . ./0_shell.sh; CARGO_TARGET_DIR="$lab_dir/target" lab_cargo_manifest "$lab_dir/../../shared/rollback/Cargo.toml" test

# Resumable same-host mirror. Downloaded source bytes remain outside Git.
mirror:
    mkdir -p ../fixtures/rukaidata-mirror
    wget --compression=auto --adjust-extension --recursive --level=inf --page-requisites --no-clobber --domains=rukaidata.com --quota=4g --wait=0.2 --random-wait --limit-rate=4m --timeout=30 --tries=3 --directory-prefix=../fixtures/rukaidata-mirror --output-file=../fixtures/rukaidata-mirror/download.log 'https://rukaidata.com/PM3.6/Captain%20Falcon/' https://rukaidata.com/

# SQL checks, tracing report, and full-state golden comparison.
verify:
    sh 67_run_perf.sh

trace: verify

# Release-only measurement with no tracing subscriber.
bench:
    sh 71_run_release.sh

# Local keyboard control: A/D or arrows, Space jump, J fair, Esc exit.
play:
    sh 91_run_control.sh --play

test-controls:
    sh 91_run_control.sh --test

web-build:
    sh 95_web.sh build

web-check:
    sh 95_web.sh check

web-plan:
    sh 95_web.sh plan

web-verify:
    node 94_web/4_browser.mjs

# Publishes only the exact browser-verified export, preserving a remote backup.
web-publish:
    node 94_web/5_publish.mjs

# Sequential gates; publishing rejects artifacts changed after the browser test.
web-deploy: prove deploy

web-setup:
    pnpm --dir 94_web install --frozen-lockfile
    pnpm --dir 94_web exec playwright install chromium

import-check:
    sh 98_import.sh check

import-fetch:
    sh 98_import.sh fetch

# live includes baseline, pause/restart, and cold attachment recordings.
record mode="live":
    #!/usr/bin/env bash
    set -euo pipefail
    case {{quote(mode)}} in
      control) sh 91_run_control.sh ;;
      repeat) sh 79_run_repeat.sh ;;
      live|lifecycle) sh 89_run_live.sh ;;
      processes) sh 77_run_processes.sh ;;
      godot) bash 29_run_godot.sh ;;
      incremental) bash 40_run_incremental.sh ;;
      scheduled) bash 46_run_schedule.sh ;;
      faults) bash 55_run_faults.sh ;;
      sql) bash 22_run_sql.sh ;;
      launch) bash 15_run_launch.sh ;;
      rollback) bash 9_run_rollback.sh ;;
      knee) bash 3_run.sh ;;
      *) printf 'Unknown recording: %s\n' {{quote(mode)}} >&2; exit 2 ;;
    esac
