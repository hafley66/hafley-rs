# Living structural timeline. New architecture milestones go above inventory.
# Stable IDs map to evidence/task IDs in 2_roadmap.md and 3_tasks.md.
direction: up
classes: {
  done: {style.fill: "#DCFCE7"; style.stroke: "#166534"; style.font-color: "#123522"}
  partial: {style.fill: "#E0F2FE"; style.stroke: "#0369A1"; style.font-color: "#12304A"}
  queued: {style.fill: "#FEF3C7"; style.stroke: "#92400E"; style.font-color: "#452B10"; style.stroke-dash: 4}
  source: {style.fill: "#F1F5F9"; style.stroke: "#64748B"; style.font-color: "#243247"}
  retired: {style.fill: "#FEE2E2"; style.stroke: "#991B1B"; style.font-color: "#591B1B"}
}
board: "HAFLEY-RS / GAMES · structural timeline · grows upward" {
  grid-columns: 1
  grid-gap: 48
  legend: "STATUS · evidence scope stays attached to each node" {
    grid-columns: 5
    a: "DONE\nscoped proof" {class: done}
    b: "PARTIAL\nintegration remains" {class: partial}
    c: "QUEUED\nnot executed" {class: queued}
    d: "SOURCE\nextract / inspect" {class: source}
    e: "RETIRED\nretain history" {class: retired}
  }
  inventory: @classification/3_registry
  m11: "11 · 2026-09-11 PERMANENT SOURCE/RUNTIME COVERAGE JOIN" {
    grid-columns: 3
    profile: "AUTHORED · Pigeon/Falcon-like gameplay\nExplicit source IDs → Rust runtime phases\nItem-system exclusions expanded per source row\nRequired axes and pinned source revision" {class: source}
    observed: "OBSERVED · generated inventories\n12 source inventory: 341 states / 1,314 associations / 1,993 calls\n721 callbacks; 1,939 unresolved source records\n14 runtime inventory: phases/callback identities/witness partitions" {class: partial}
    coverage: "CURRENT · 22/248 state mapping · 8.87%\nLive reachability 18/248 · 7.26%\nCallback 0/1,314 · guards 0/1,993\nRollback/fidelity 0/248: legacy receipt only\nRequirement receipts: 0" {class: partial}
  }
  m10: "10 · 2026-09-11 V1 COMBAT / direct port and Pigeon receiver" {
    grid-columns: 5
    donor: "SOURCE · v1 Rust combat\ncombat + physics + moves + fighter + step\nDirect port, not freeze-first\nVectors execute in crate tests" {class: source}
    resolver: "STAGE 2 · game-combat resolver\nDamage + KB + Sakurai angle + DI\nHitlag + hitstun + tumble policy\nPure crate; ssbm_utils 0.4.0" {class: partial}
    receiver: "DONE · Pigeon receiver wiring\nSingle sandbag contact resolves\nParry + Rapier apply outside\nSnapshot suffix replay proven" {class: done}
    fighter: "ACTIVE · shared fighter response\nHitlag + hitstun + tumble + DI\nC3 transition-point restore tapes\n2.7 not earned" {class: partial}
    adapters: "QUEUED · contact + body adapters\nBones to Parry candidates\nRapier durable state boundary\nNative/WASM rollback gate" {class: queued}
  }
  m9: "09 · 2026-09-10 DIRECT C-TO-RUST PORT / shared ftCommon callbacks" {
    grid-columns: 3
    translator: "SOURCE · tree-sitter-c 0.24 / 0.23.4 MIT\nLowered expressions + statements\ncalls mapped to typed effects\nelse errors, no C compiler" {class: source}
    port: "TESTED · game-ftcommon crate\npure guard + ordered effect arrays\nmotion, setup, writes, aerial Vec3\nrepo/revision/path/line-span kept" {class: done}
    open: "UNRESOLVED · x34/x78 + co_attrs inputs\nOpaque effects keep C symbols\nNo live consumer; stage 2.7" {class: partial}
  }
  m8: "08 · 2026-09-10 PINNED-SOURCE CODEGEN / Pigeon guards from Melee decomp" {
    grid-columns: 3
    origin: "SOURCE · two distinct origins\nRukaidata GitHub: generator/parser\nRetained PM3.6 pages: base64+bincode\nNo raw PAC/GCT input in checkout" {class: source}
    rules: "DONE · 61b2195 · 5 extracted rules\nturn_request + takeoff + air_jump\nSourceRef repo/revision/path/line\nRendered chart D2 + SVG" {class: done}
    open: "UNRESOLVED · 3 source values\np_ftCommonData x34/x78: DAT absent\nLandingLight: no PM selection rule\nNo fidelity claim; stage delta 0" {class: partial}
  }
  m7: "07 · 2026-09-10 UI ROUTING / INPUT ADAPTERS / DEPLOY + NET" {
    grid-columns: 4
    router: "STAGE 1 · game-ui proposal\nPure Location/Nav/NavCmd reducer\nURI codec + dialog gate + history\ncrates/ui; no crate or manifest yet" {class: queued}
    adapters: "ACTIVE · Godot host adapters\nKeys last-pressed + generic first pad\nWeb touch bar; no GameCube adapter\nHardware unmeasured" {class: partial}
    consumers: "PENDING · one UiState\nNative + WASM, Godot first\nRenderer helpers egui-kit separate\nNo UI authority in egui-kit" {class: queued}
    deploy: "PARTIAL · /game3 older receipt\nDeploy a5ce0af; prove 98b4631\nCurrent source fingerprint stale\nRollback isolated; netplay unqualified" {class: partial}
  }
  m6: "06 · 2026-09-10 GATES / verified foundations + active next gates" {
    grid-columns: 4
    foundation: "DONE · integrated today\nDeployed a5ce0af + observer fc11379\nProgress view 6bb2d0f\nBoop delivery 841115a/bcdeb2c" {class: done}
    labs: "LABS · pending promotion" {
      grid-columns: 1
      statechart: "ACTIVE · runtime statechart UI\nReadable phase overlay + geometry\nGodot observed presentation\nUnintegrated, no SHA" {class: partial}
    }
    libs: "REUSABLE-LIBRARY CANDIDATES · crates/" {
      grid-columns: 1
      trace: "PENDING · input/world/state trace\nBounded rotation + atomic consume\nBackend record stream; no code yet" {class: queued}
      harness: "ACTIVE · mocked real-harness\nRecovery backbone\nBoop test infrastructure\nNot a game package stage" {class: partial}
    }
    app: "APP WORK · smash/ + browser" {
      grid-columns: 1
      input: "ACTIVE · browser dash dance\nSimultaneous-direction resolver\nResolver -> crates/input candidate\nUnintegrated, no SHA" {class: partial}
