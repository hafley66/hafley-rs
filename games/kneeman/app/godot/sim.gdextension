; Tells Godot where to find the built native lib (a .gdextension descriptor).
; The dylib lives in the workspace target/ one level above the godot project,
; hence the res://../ paths (dev-run pattern from the gdext book; exports need copies).

[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
linux.debug.x86_64     = "res://../target/debug/libsmash_sim.so"
linux.release.x86_64   = "res://../target/release/libsmash_sim.so"
macos.debug            = "res://../target/debug/libsmash_sim.dylib"
macos.release          = "res://../target/release/libsmash_sim.dylib"
macos.debug.arm64      = "res://../target/debug/libsmash_sim.dylib"
macos.release.arm64    = "res://../target/release/libsmash_sim.dylib"
windows.debug.x86_64   = "res://../target/debug/smash_sim.dll"
windows.release.x86_64 = "res://../target/release/smash_sim.dll"
web.debug.wasm32       = "res://bin/smash_sim.wasm"
web.release.wasm32     = "res://bin/smash_sim.wasm"
