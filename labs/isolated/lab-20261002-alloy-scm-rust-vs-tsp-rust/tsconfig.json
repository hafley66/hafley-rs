{
  "compilerOptions": {
    "lib": [
      "es2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@alloy-js/core",
    "typeRoots": [
      "./node_modules/@types",
      "./.types"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "core/**/*",
    "rust/**/*",
    "gen/**/*",
    "twins/**/*",
    "*.tsx",
    "*.ts"
  ]
}
