direction: right
style.fill: "#101820"
classes: {
  phase: {style: {fill: "#18303b"; stroke: "#65d9e6"; font-color: "#e2edf0"; border-radius: 8}}
}
board: "Grounded local policy / evaluated semantic guards" {
  grid-columns: 1
  style: {fill: "#101820"; stroke: "#30424e"; font-color: "#e2edf0"}
  JumpRequest: "JumpRequest" {
    style: {fill: "#14232e"; stroke: "#30424e"; font-color: "#65d9e6"}
    Idle.class: phase
    Squat.class: phase
    Idle -> Squat: "true" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Walk.class: phase
    Squat.class: phase
    Walk -> Squat: "true" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Dash.class: phase
    Squat.class: phase
    Dash -> Squat: "true" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Run.class: phase
    Squat.class: phase
    Run -> Squat: "true" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Brake.class: phase
    Squat.class: phase
    Brake -> Squat: "true" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Turn.class: phase
    Squat.class: phase
    Turn -> Squat: "true" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Crouch.class: phase
    Squat.class: phase
    Crouch -> Squat: "true" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
  }
  GroundIntent: "GroundIntent" {
    style: {fill: "#14232e"; stroke: "#30424e"; font-color: "#65d9e6"}
    Idle.class: phase
    Walk.class: phase
    Idle -> Walk: "!dash && walk && !down" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Idle.class: phase
    Dash.class: phase
    Idle -> Dash: "dash && !down" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Idle.class: phase
    Crouch.class: phase
    Idle -> Crouch: "down" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Dash.class: phase
    Dash.class: phase
    Dash -> Dash: "dash && !down" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Dash.class: phase
    Crouch.class: phase
    Dash -> Crouch: "down" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Run.class: phase
    Dash.class: phase
    Run -> Dash: "dash && !down" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Run.class: phase
    Crouch.class: phase
    Run -> Crouch: "down" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
  }
  Motion: "Motion" {
    style: {fill: "#14232e"; stroke: "#30424e"; font-color: "#65d9e6"}
    Walk.class: phase
    Idle.class: phase
    Walk -> Idle: "!dash && !walk" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Walk.class: phase
    Dash.class: phase
    Walk -> Dash: "dash" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Dash.class: phase
    Dash.class: phase
    Dash -> Dash: "reverse" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Dash.class: phase
    Run.class: phase
    Dash -> Run: "forward && !reverse && finished" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Dash.class: phase
    Brake.class: phase
    Dash -> Brake: "!forward && !reverse" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Run.class: phase
    Brake.class: phase
    Run -> Brake: "!walk && !reverse" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Run.class: phase
    Turn.class: phase
    Run -> Turn: "reverse" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Run.class: phase
    Crouch.class: phase
    Run -> Crouch: "walk && !reverse && down" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Brake.class: phase
    Idle.class: phase
    Brake -> Idle: "stopped" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Turn.class: phase
    Idle.class: phase
    Turn -> Idle: "!reverse && finished" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Turn.class: phase
    Dash.class: phase
    Turn -> Dash: "reverse" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Squat.class: phase
    Jump.class: phase
    Squat -> Jump: "finished" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Crouch.class: phase
    Idle.class: phase
    Crouch -> Idle: "!down" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
    Landing.class: phase
    Idle.class: phase
    Landing -> Idle: "finished" {style: {stroke: "#65d9e6"; font-color: "#efcf75"}}
  }
}
