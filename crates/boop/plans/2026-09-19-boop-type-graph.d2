# generated by crates/boop/scripts/typegraph-d2.sh -- do not hand-edit
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    pad: 30
    center: true
  }
}
direction: down

classes: {
  c_boop_proc: { style: { fill: "#7a3d8f"; stroke: "#0b0d10"; font-color: "#f6ecfa"; border-radius: 6; stroke-width: 1 } }
  c_boop_turnstrip: { style: { fill: "#5b5f22"; stroke: "#0b0d10"; font-color: "#f4f5e6"; border-radius: 6; stroke-width: 1 } }
  c_boop_store: { style: { fill: "#1d6b4f"; stroke: "#0b0d10"; font-color: "#e8f7ef"; border-radius: 6; stroke-width: 1 } }
  c_boop_harness: { style: { fill: "#a8531c"; stroke: "#0b0d10"; font-color: "#fdf0e6"; border-radius: 6; stroke-width: 1 } }
  c_boop_mux: { style: { fill: "#146b74"; stroke: "#0b0d10"; font-color: "#e6f6f8"; border-radius: 6; stroke-width: 1 } }
  c_boop_acp: { style: { fill: "#8f2f3f"; stroke: "#0b0d10"; font-color: "#fbebee"; border-radius: 6; stroke-width: 1 } }
  c_boop: { style: { fill: "#1f4f82"; stroke: "#0b0d10"; font-color: "#eaf2fb"; border-radius: 6; stroke-width: 1 } }
}

ToolCallFact: "ToolCallFact" { class: c_boop_acp }
ProcessIdentity: "ProcessIdentity" { class: c_boop_proc }
HarnessId: "HarnessId" { class: c_boop_store }
Store: "Store" { class: c_boop_store }
TurnKind: "TurnKind" { class: c_boop_turnstrip }
QueryFormat: "QueryFormat" { class: c_boop }
Capabilities: "Capabilities" { class: c_boop_harness }
LiveSession: "LiveSession" { class: c_boop_harness }
Message: "Message" { class: c_boop_harness }
TerminalSnapshot: "TerminalSnapshot" { class: c_boop_mux }
ProcReader: "ProcReader" { class: c_boop_store }
Route: "Route" { class: c_boop_store }
LaneCmd: "LaneCmd" { class: c_boop }
LaneChannel: "LaneChannel" { class: c_boop_acp }
LiveSessions: "LiveSessions" { class: c_boop_harness }
NativeTuiPlan: "NativeTuiPlan" { class: c_boop_harness }
AgentRuntimeRow: "AgentRuntimeRow" { class: c_boop_store }
AgentSessionGraph: "AgentSessionGraph" { class: c_boop_store }
LaneRuntime: "LaneRuntime" { class: c_boop_store }
BeepCmd: "BeepCmd" { class: c_boop }
Door: "Door" { class: c_boop_harness }
Multiplexer: "Multiplexer" { class: c_boop_mux }
DbCmd: "DbCmd" { class: c_boop }
Harness: "Harness" { class: c_boop_harness }
AgentSessionGraphRuntime: "AgentSessionGraphRuntime" { class: c_boop_store }
AgentSummaryQuery: "AgentSummaryQuery" { class: c_boop_store }
RuntimeSnapshotInput: "RuntimeSnapshotInput" { class: c_boop_store }
SubCmd: "SubCmd" { class: c_boop }

# edge stroke = the crate doing the pointing.
# solid = same crate, dashed = crosses a crate boundary,
# thicker = skips a tier (a candidate for the wrong stratum).
AgentSessionGraphRuntime -> Route: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
AgentSessionGraphRuntime -> Message: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 4; opacity: 0.85 } }
AgentSessionGraphRuntime -> Multiplexer: { style: { stroke: "#1d6b4f"; stroke-width: 1; stroke-dash: 4; opacity: 0.85 } }
AgentSessionGraphRuntime -> ProcReader: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
AgentSummaryQuery -> Store: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
AgentSummaryQuery -> Route: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
AgentSummaryQuery -> Message: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 4; opacity: 0.85 } }
AgentSummaryQuery -> Multiplexer: { style: { stroke: "#1d6b4f"; stroke-width: 1; stroke-dash: 4; opacity: 0.85 } }
AgentSummaryQuery -> ProcReader: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
BeepCmd -> LaneCmd: { style: { stroke: "#1f4f82"; stroke-width: 1; stroke-dash: 0; opacity: 0.85 } }
DbCmd -> QueryFormat: { style: { stroke: "#1f4f82"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
Door -> LiveSession: { style: { stroke: "#a8531c"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
Door -> NativeTuiPlan: { style: { stroke: "#a8531c"; stroke-width: 1; stroke-dash: 0; opacity: 0.85 } }
Door -> Route: { style: { stroke: "#a8531c"; stroke-width: 3; stroke-dash: 4; opacity: 0.85 } }
Harness -> HarnessId: { style: { stroke: "#a8531c"; stroke-width: 3; stroke-dash: 4; opacity: 0.85 } }
Harness -> Capabilities: { style: { stroke: "#a8531c"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
Harness -> Route: { style: { stroke: "#a8531c"; stroke-width: 3; stroke-dash: 4; opacity: 0.85 } }
Harness -> LiveSessions: { style: { stroke: "#a8531c"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
Harness -> Door: { style: { stroke: "#a8531c"; stroke-width: 1; stroke-dash: 0; opacity: 0.85 } }
Harness -> Store: { style: { stroke: "#a8531c"; stroke-width: 3; stroke-dash: 4; opacity: 0.85 } }
Harness -> LaneChannel: { style: { stroke: "#a8531c"; stroke-width: 3; stroke-dash: 4; opacity: 0.85 } }
Harness -> Message: { style: { stroke: "#a8531c"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
LaneChannel -> ToolCallFact: { style: { stroke: "#8f2f3f"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
LaneCmd -> QueryFormat: { style: { stroke: "#1f4f82"; stroke-width: 1; stroke-dash: 0; opacity: 0.85 } }
LaneRuntime -> ProcessIdentity: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 4; opacity: 0.85 } }
LiveSession -> HarnessId: { style: { stroke: "#a8531c"; stroke-width: 1; stroke-dash: 4; opacity: 0.85 } }
LiveSessions -> LiveSession: { style: { stroke: "#a8531c"; stroke-width: 1; stroke-dash: 0; opacity: 0.85 } }
LiveSessions -> Route: { style: { stroke: "#a8531c"; stroke-width: 1; stroke-dash: 4; opacity: 0.85 } }
Message -> HarnessId: { style: { stroke: "#a8531c"; stroke-width: 1; stroke-dash: 4; opacity: 0.85 } }
Multiplexer -> LiveSessions: { style: { stroke: "#146b74"; stroke-width: 1; stroke-dash: 4; opacity: 0.85 } }
Multiplexer -> TerminalSnapshot: { style: { stroke: "#146b74"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
Route -> HarnessId: { style: { stroke: "#1d6b4f"; stroke-width: 1; stroke-dash: 0; opacity: 0.85 } }
RuntimeSnapshotInput -> Store: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
RuntimeSnapshotInput -> Route: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
RuntimeSnapshotInput -> Message: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 4; opacity: 0.85 } }
RuntimeSnapshotInput -> Multiplexer: { style: { stroke: "#1d6b4f"; stroke-width: 1; stroke-dash: 4; opacity: 0.85 } }
RuntimeSnapshotInput -> ProcReader: { style: { stroke: "#1d6b4f"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
SubCmd -> BeepCmd: { style: { stroke: "#1f4f82"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
SubCmd -> QueryFormat: { style: { stroke: "#1f4f82"; stroke-width: 3; stroke-dash: 0; opacity: 0.85 } }
SubCmd -> DbCmd: { style: { stroke: "#1f4f82"; stroke-width: 1; stroke-dash: 0; opacity: 0.85 } }

layers: {
  crates: {
    direction: down
    grid-columns: 3
    grid-gap: 24
    w_boop_proc: "boop-proc" {
      style: { fill: "#7a3d8f"; stroke: "#0b0d10"; font-color: "#f6ecfa"; border-radius: 8 }
      tbl: "1 types" {
        shape: sql_table
        ProcessIdentity: tier 0
      }
    }
    w_boop_turnstrip: "boop-turnstrip" {
      style: { fill: "#5b5f22"; stroke: "#0b0d10"; font-color: "#f4f5e6"; border-radius: 8 }
      tbl: "1 types" {
        shape: sql_table
        TurnKind: tier 0
      }
    }
    w_boop_store: "boop-store" {
      style: { fill: "#1d6b4f"; stroke: "#0b0d10"; font-color: "#e8f7ef"; border-radius: 8 }
      tbl: "10 types" {
        shape: sql_table
        HarnessId: tier 0
        Store: tier 0
        ProcReader: tier 1
        Route: tier 1
        AgentRuntimeRow: tier 2
        AgentSessionGraph: tier 2
        LaneRuntime: tier 2
        AgentSessionGraphRuntime: tier 4
        AgentSummaryQuery: tier 4
        RuntimeSnapshotInput: tier 4
      }
    }
    w_boop_harness: "boop-harness" {
      style: { fill: "#a8531c"; stroke: "#0b0d10"; font-color: "#fdf0e6"; border-radius: 8 }
      tbl: "7 types" {
        shape: sql_table
        Capabilities: tier 1
        LiveSession: tier 1
        Message: tier 1
        LiveSessions: tier 2
        NativeTuiPlan: tier 2
        Door: tier 3
        Harness: tier 4
      }
    }
    w_boop_mux: "boop-mux" {
      style: { fill: "#146b74"; stroke: "#0b0d10"; font-color: "#e6f6f8"; border-radius: 8 }
      tbl: "2 types" {
        shape: sql_table
        TerminalSnapshot: tier 1
        Multiplexer: tier 3
      }
    }
    w_boop_acp: "boop-acp" {
      style: { fill: "#8f2f3f"; stroke: "#0b0d10"; font-color: "#fbebee"; border-radius: 8 }
      tbl: "2 types" {
        shape: sql_table
        ToolCallFact: tier 0
        LaneChannel: tier 2
      }
    }
    w_boop: "boop" {
      style: { fill: "#1f4f82"; stroke: "#0b0d10"; font-color: "#eaf2fb"; border-radius: 8 }
      tbl: "5 types" {
        shape: sql_table
        QueryFormat: tier 0
        LaneCmd: tier 1
        BeepCmd: tier 2
        DbCmd: tier 3
        SubCmd: tier 4
      }
    }
  }
}
