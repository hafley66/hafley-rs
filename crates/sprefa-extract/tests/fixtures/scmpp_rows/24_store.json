  ],
  "steps": [
    {
      "action": "copy",
      "source": "$fixtures/scmpp_rows/inputs/fixture.rs",
      "path": "$work/fixture.rs"
    },
    {
      "action": "copy",
      "source": "$fixtures/scmpp_rows/inputs/query_26.scm",
      "path": "$work/query.scm"
    },
    {
      "action": "run",
      "name": "query",
      "arguments": [
        "query",
        "--scmpp",
        "$work/query.scm",
        "--sqlite",
        "$work/scmpp.db",
        "$work/fixture.rs"
      ],
      "environment": {
        "DL_TRAIL": "0"
      },
      "expect_exit_code": 0,
