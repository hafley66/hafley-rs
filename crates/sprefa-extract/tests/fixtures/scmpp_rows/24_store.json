      "sql": "SELECT (SELECT count(*) FROM scmpp_row), (SELECT count(*) FROM scmpp_node WHERE named = 1), (SELECT count(*) FROM scmpp_node WHERE named = 0), (SELECT count(*) FROM scmpp_node WHERE parent >= 0), (SELECT count(*) FROM scmpp_node WHERE field <> 0), (SELECT count(*) FROM scmpp_capture)",
      "expect": [
        [
          {
            "integer": 3
          },
          {
            "integer": 69
          },
          {
            "integer": 58
          },
          {
            "integer": 126
          },
          {
            "integer": 54
          },
          {
            "integer": 23
          }
