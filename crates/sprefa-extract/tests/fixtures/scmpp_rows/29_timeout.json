{
  "steps": [
    {
      "action": "copy",
      "source": "$fixtures/scmpp_rows/inputs/deep.rs",
      "path": "$work/deep.rs"
    },
    {
      "action": "copy",
      "source": "$fixtures/scmpp_rows/inputs/query_34.scm",
      "path": "$work/deep.scm"
    },
    {
      "action": "run",
      "name": "query",
      "arguments": [
        "query",
        "--timeout",
        "1",
        "--scmpp",
        "$work/deep.scm",
        "$work/deep.rs"
      ],
      "environment": {
        "DL_TRAIL": "0"
      },
      "expect_exit_code": 3,
      "raw_stdout": true,
      "hard_deadline_ms": 30000,
      "maximum_seconds": 30,
      "trim_stderr": true
    }
  ]
}
