{
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_ts/basic",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "run",
      "name": "plan",
      "arguments": [
        "cleave",
        "src/util.ts#loadConfig",
        "src/config.ts",
        "--json",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "stage [0-9a-f]{64}",
          "replacement": "stage <stage>"
        }
      ]
    },
    {
      "action": "tree_matches",
      "name": "unchanged",
      "left": "$work/repo",
      "right": "$fixtures/cleave_ts/basic",
      "file_bytes_only": true,
      "exclude_prefixes": [
        ".git/"
      ]
    },
    {
      "action": "json_count",
      "name": "trace_spans",
      "path": "$work/cleave.json",
      "key": "ph",
      "value": "B",
      "minimum": 0
    }
  ]
}
