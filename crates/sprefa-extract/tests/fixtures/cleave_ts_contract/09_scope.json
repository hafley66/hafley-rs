{
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_ts/basic",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "copy",
      "source": "$fixtures/cleave_ts_contract/boot.py",
      "path": "$work/repo/src/boot.py"
    },
    {
      "action": "run",
      "name": "error",
      "arguments": [
        "cleave",
        "src/boot.py#boot",
        "src/other.py",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 2,
      "raw_stdout": true,
      "unasserted_stderr": true,
      "unasserted_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "stage [0-9a-f]{64}",
          "replacement": "stage <stage>"
        }
      ]
    }
  ]
}
