{
  "steps": [
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "copy_tree",
      "source": "$fixtures/rust_move/relocate",
      "target": "$work/repo"
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "init",
        "-q",
        "."
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "-c",
        "user.email=extract@move.test",
        "-c",
        "user.name=extract-move",
        "commit",
        "-qm",
        "fixture"
      ]
    },
    {
      "action": "write",
      "path": "$work/state/moves.tsv",
      "text": "$work/repo/src/a.rs\t$work/repo/src/util/a.rs\n"
    },
    {
      "action": "run",
      "name": "move",
      "cwd": "$manifest",
      "arguments": [
        "move",
        "--list",
        "$work/state/moves.tsv",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit",
        "--relocate-mod"
      ],
      "environment": {
        "RUSTUP_TOOLCHAIN": "stable"
      },
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^((?:\\[root [^\\n]+?\\] )?stage )[0-9a-f]{64}(.*)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ],
      "expect_exit_code": 0
    },
    {
      "action": "read_tree",
      "name": "source_tree",
      "path": "$work/repo",
      "directory": true,
      "exclude_prefixes": [
        ".git/",
        "target/"
      ]
    },
    {
      "action": "run",
      "name": "cargo_check",
      "program": "$cargo",
      "arguments": [
        "check",
        "--offline"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "KACHE_DISABLED": "1",
        "RUSTUP_TOOLCHAIN": "stable"
      },
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    }
  ]
}
