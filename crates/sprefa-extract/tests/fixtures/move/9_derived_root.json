{
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/move/inputs/prolog",
      "target": "$work/left"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "cwd": "$work/left",
      "args": [
        "init",
        "-q",
        "."
      ]
    },
    {
      "action": "git",
      "cwd": "$work/left",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "action": "git",
      "cwd": "$work/left",
      "args": [
        "-c",
        "user.email=extract@move.test",
        "-c",
        "user.name=extract-move",
        "commit",
        "-qm",
        "fixture"
      ]
    },
    {
      "action": "copy_tree",
      "source": "$fixtures/move/inputs/prolog",
      "target": "$work/right"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "cwd": "$work/right",
      "args": [
        "init",
        "-q",
        "."
      ]
    },
    {
      "action": "git",
      "cwd": "$work/right",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "action": "git",
      "cwd": "$work/right",
      "args": [
        "-c",
        "user.email=extract@move.test",
        "-c",
        "user.name=extract-move",
        "commit",
        "-qm",
        "fixture"
      ]
    },
    {
      "action": "run",
      "name": "derived",
      "arguments": [
        "move",
        "$work/left/lib/b.pl",
        "$work/left/core/b.pl",
        "--state",
        "$work/state"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^((?:\\[root [^\\n]+?\\] )?stage )[0-9a-f]{64}(.*)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "run",
      "name": "explicit",
      "arguments": [
        "move",
        "$work/right/lib/b.pl",
        "$work/right/core/b.pl",
        "--root",
        "$work/right",
        "--state",
        "$work/state"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^((?:\\[root [^\\n]+?\\] )?stage )[0-9a-f]{64}(.*)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "compare",
      "name": "same_plan",
      "left": "derived",
      "right": "explicit",
      "replace_each": {
        "$work/left": "<root>",
        "$work/right": "<root>"
      },
      "regex": [
        {
          "pattern": "(?m)^(stage )[^ ]+",
          "replacement": "${1}<id>"
        }
      ]
    }
  ]
}
