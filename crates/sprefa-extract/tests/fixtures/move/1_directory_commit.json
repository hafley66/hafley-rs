{
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/move/inputs/helpers",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "init",
        "-q",
        "."
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "-c",
        "user.email=extract@move.test",
        "-c",
        "user.name=extract-move",
        "commit",
        "-qm",
        "fixture"
      ]
    },
    {
      "action": "write",
      "path": "$work/state/moves.tsv",
      "text": "$work/repo/tests/helpers/one.mjs\t$work/repo/tests/3_integration/helpers/one.mjs\n$work/repo/tests/helpers/two.mjs\t$work/repo/tests/3_integration/helpers/two.mjs\n"
    },
    {
      "action": "run",
      "name": "move",
      "arguments": [
        "move",
        "--list",
        "$work/state/moves.tsv",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^((?:\\[root [^\\n]+?\\] )?stage )[0-9a-f]{64}(.*)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "claim",
      "name": "claim_1",
      "kind": "line_count",
      "cell": "move",
      "line_prefix": "rmdir ",
      "expect": 1
    },
    {
      "action": "claim",
      "name": "claim_2",
      "kind": "contains",
      "cell": "move",
      "text": "rmdir tests/helpers"
    },
    {
      "action": "exists",
      "name": "path_3",
      "path": "$work/repo/tests/helpers",
      "expected": false
    },
    {
      "action": "exists",
      "name": "path_4",
      "path": "$work/repo/tests/0_keeper.test.mjs",
      "expected": true,
      "kind": "file"
    },
    {
      "action": "exists",
      "name": "path_5",
      "path": "$work/repo/tests",
      "expected": true,
      "kind": "directory"
    },
    {
      "action": "exists",
      "name": "path_6",
      "path": "$work/repo/tests/3_integration/helpers/one.mjs",
      "expected": true,
      "kind": "file"
    }
  ]
}
