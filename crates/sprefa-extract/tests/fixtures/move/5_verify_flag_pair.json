{
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/move/inputs/prolog",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "init",
        "-q",
        "."
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "-c",
        "user.email=extract@move.test",
        "-c",
        "user.name=extract-move",
        "commit",
        "-qm",
        "fixture"
      ]
    },
    {
      "action": "run",
      "name": "move",
      "arguments": [
        "move",
        "$work/repo/lib/b.pl",
        "$work/repo/core/b.pl",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--verify",
        "true"
      ],
      "expect_exit_code": 2,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^((?:\\[root [^\\n]+?\\] )?stage )[0-9a-f]{64}(.*)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "claim",
      "name": "claim_27",
      "kind": "contains",
      "cell": "move.stderr",
      "text": "--verify"
    },
    {
      "action": "claim",
      "name": "claim_28",
      "kind": "contains",
      "cell": "move.stderr",
      "text": "--commit"
    }
  ]
}
