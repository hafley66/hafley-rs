{
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/move/inputs/helpers",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "init",
        "-q",
        "."
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "-c",
        "user.email=extract@move.test",
        "-c",
        "user.name=extract-move",
        "commit",
        "-qm",
        "fixture"
      ]
    },
    {
      "action": "copy_tree",
      "source": "$work/repo",
      "target": "$work/before"
    },
    {
      "action": "write",
      "path": "$work/state/moves.tsv",
      "text": "$work/repo/tests/helpers/one.mjs\t$work/repo/tests/3_integration/helpers/one.mjs\n$work/repo/tests/helpers/two.mjs\t$work/repo/tests/3_integration/helpers/two.mjs\n"
    },
    {
      "action": "run",
      "name": "move",
      "arguments": [
        "move",
        "--list",
        "$work/state/moves.tsv",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit",
        "--verify",
        "false"
      ],
      "expect_exit_code": 3,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^((?:\\[root [^\\n]+?\\] )?stage )[0-9a-f]{64}(.*)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "claim",
      "name": "claim_24",
      "kind": "contains",
      "cell": "move",
      "text": "verify failed (rc=1): rolled back"
    },
    {
      "action": "tree_matches",
      "name": "rollback_tree",
      "left": "$work/repo",
      "right": "$work/before",
      "file_bytes_only": true,
      "opaque_prefixes": [
        ".git/"
      ],
      "opaque_groups": [
        ".git/objects/"
      ]
    },
    {
      "action": "exists",
      "name": "path_25",
      "path": "$work/repo/tests/helpers/one.mjs",
      "expected": true,
      "kind": "file"
    },
    {
      "action": "exists",
      "name": "path_26",
      "path": "$work/repo/tests/0_keeper.test.mjs",
      "expected": true,
      "kind": "file"
    }
  ]
}
