{
 "test": "source_dependencies_are_imported_into_destination",
 "steps": [
  {
   "action": "copy_tree",
   "source": "$fixtures/cleave_ts_oracle/dependencies",
   "target": "$work/repo",
   "fresh": true
  },
  {
   "action": "directory",
   "path": "$work/state"
  },
  {
   "action": "git",
   "args": [
    "init",
    "-q",
    "."
   ],
   "cwd": "$work/repo"
  },
  {
   "action": "command",
   "program": "$ryii",
   "arguments": [
    "cleave",
    "source.ts#run",
    "dest.ts",
    "--commit",
    "--root",
    "$work/repo",
    "--state",
    "$work/state"
   ],
   "cwd": "$work/repo",
   "environment": {
    "RUST_LOG": "error"
   },
   "expect_exit_code": 0,
   "capture": "deps",
   "raw_stdout": true,
   "unasserted_stderr": true,
   "stdout_redactions": [
    {
     "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
     "replacement": "${1}$$STAGE${2}"
    }
   ]
  },
  {
   "action": "read_tree",
   "path": "$work/repo/dest.ts",
   "capture": "dest"
  },
  {
   "action": "claim",
   "kind": "contains",
   "cell": "dest",
   "text": "import { helper } from",
   "name": "helper_imported"
  },
  {
   "action": "claim",
   "kind": "contains",
   "cell": "dest",
   "text": "import type { Dependency } from",
   "name": "dependency_type_imported"
  }
 ]
}
