{
  "tests": [
    "stable_universe_agrees_with_itself_and_leaves_the_tree_untouched",
    "unknown_kind_is_a_clap_reject_naming_the_kind",
    "unranked_entrypoints_union_and_ranked_paths_pick_the_best_rank",
    "numbered_stems_keep_full_stems_and_omit_colliding_blocked_moves"
  ],
  "steps": [
    {"action": "copy_tree", "source": "$fixtures/stratify_ts", "target": "$work/stable_before", "fresh": true},
    {"action": "copy_tree", "source": "$fixtures/stratify_ts", "target": "$work/stable", "fresh": true},
    {"action": "command", "arguments": ["stratify", "--from", "main.ts:main=1", "--base-lines", "200", "--root", "$work/stable", "."], "cwd": "$work/stable", "capture": "stable_first", "unasserted_stderr": true},
    {"action": "command", "arguments": ["stratify", "--from", "main.ts:main=1", "--base-lines", "200", "--root", "$work/stable", "."], "cwd": "$work/stable", "capture": "stable_second", "unasserted_stderr": true},
    {"action": "claim", "name": "stable_runs_agree", "kind": "cells_equal", "left": "stable_first.stdout", "right": "stable_second.stdout"},
    {"action": "tree_matches", "name": "stable_tree_unchanged", "left": "$work/stable", "right": "$work/stable_before"},
    {"action": "claim", "name": "stable_stratum_rows", "kind": "count_substring", "cell": "stable_first.stdout", "text": "\"record\":\"stratum\"", "expect": 7},
    {"action": "claim", "name": "stable_cycle_rows", "kind": "count_substring", "cell": "stable_first.stdout", "text": "\"record\":\"stratum_cycle\"", "expect": 2},
    {"action": "claim", "name": "stable_locality_rows", "kind": "count_substring", "cell": "stable_first.stdout", "text": "\"record\":\"locality\"", "expect": 7},
    {"action": "claim", "name": "stable_move_reasons", "kind": "count_substring", "cell": "stable_first.stdout", "text": "\"reason\":\"move_candidate\"", "expect": 3},
    {"action": "claim", "name": "stable_depth_prefix_reasons", "kind": "count_substring", "cell": "stable_first.stdout", "text": "\"reason\":\"depth_prefix\"", "expect": 7},
    {"action": "claim", "name": "stable_split_reasons", "kind": "count_substring", "cell": "stable_first.stdout", "text": "\"reason\":\"split_candidate\"", "expect": 2},
    {"action": "claim", "name": "stable_merge_reasons", "kind": "count_substring", "cell": "stable_first.stdout", "text": "\"reason\":\"merge_candidate\"", "expect": 2},
    {"action": "claim", "name": "stable_split_cut_lines", "kind": "json_len", "cell": "stable_first.stdout", "line_contains": "\"reason\":\"split_candidate\"", "pointer": "cut_lines", "expect": 1},
    {"action": "claim", "name": "stable_merge_shared_edges", "kind": "json_scalar", "cell": "stable_first.stdout", "line_contains": "\"reason\":\"merge_candidate\"", "pointer": "shared_edges", "expect": 6},
    {"action": "claim", "name": "stable_prefix_move_tsv", "kind": "json_scalar", "cell": "stable_first.stdout", "line_contains": "\"record\":\"stratify_move\"", "pointer": "move_tsv", "expect": "cycle_a.ts\t0_cycle_a.ts"},
    {"action": "write", "path": "$work/stratify.tsv", "text": "cycle_a.ts\t0_cycle_a.ts\n"},
    {"action": "directory", "path": "$work/state"},
    {"action": "command", "arguments": ["move", "--list", "$work/stratify.tsv", "--root", "$work/stable", "--state", "$work/state"], "cwd": "$work/stable", "capture": "move_accepted", "raw_stdout": true, "stdout_redactions": [{"pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$", "replacement": "${1}$$STAGE${2}"}]},

    {"action": "copy_tree", "source": "$fixtures/stratify_ts", "target": "$work/bad_kind", "fresh": true},
    {"action": "command", "arguments": ["stratify", "--from", "main.ts:main=1", "--kind", "value", "--root", "$work/bad_kind", "."], "cwd": "$work/bad_kind", "success": false, "expect_exit_code": 2, "capture": "bad_kind"},
    {"action": "claim", "name": "bad_kind_message", "kind": "contains", "cell": "bad_kind.stderr", "text": "unknown --kind value"},

    {"action": "copy_tree", "source": "$fixtures/stratify_ts", "target": "$work/entrypoints", "fresh": true},
    {"action": "command", "arguments": ["stratify", "--from", "main.ts:main", "--from", "small.ts:small", "--root", "$work/entrypoints", "."], "cwd": "$work/entrypoints", "capture": "unranked", "unasserted_stderr": true},
    {"action": "claim", "name": "unranked_entry_depth", "kind": "json_scalar", "cell": "unranked.stdout", "line_contains": "\"path\":\"target.ts\",\"prefix\"", "pointer": "entry_depth", "expect": 1},
    {"action": "claim", "name": "unranked_via", "kind": "json_scalar", "cell": "unranked.stdout", "line_contains": "\"path\":\"target.ts\",\"prefix\"", "pointer": "via", "expect": "small.ts:small"},
    {"action": "command", "arguments": ["stratify", "--from", "main.ts:main=1", "--from", "small.ts:small=2", "--root", "$work/entrypoints", "."], "cwd": "$work/entrypoints", "capture": "ranked", "unasserted_stderr": true},
    {"action": "claim", "name": "ranked_via", "kind": "json_scalar", "cell": "ranked.stdout", "line_contains": "\"path\":\"target.ts\",\"prefix\"", "pointer": "via", "expect": "small.ts:small"},
    {"action": "claim", "name": "ranked_entry_depth", "kind": "json_scalar", "cell": "ranked.stdout", "line_contains": "\"path\":\"target.ts\",\"prefix\"", "pointer": "entry_depth", "expect": 1},

    {"action": "copy_tree", "source": "$fixtures/stratify_ts", "target": "$work/numbered", "fresh": true},
    {"action": "write", "path": "$work/numbered/0_log.ts", "text": "export function leaf(){return 1}\n"},
    {"action": "write", "path": "$work/numbered/4_jsxAuto.test.ts", "text": "export function leaf(){return 1}\n"},
    {"action": "write", "path": "$work/numbered/2a_Signal.browser.test.ts", "text": "export function leaf(){return 1}\n"},
    {"action": "write", "path": "$work/numbered/10_history.memory.ts", "text": "export function leaf(){return 1}\n"},
    {"action": "write", "path": "$work/numbered/3_plain.tsx", "text": "export function leaf(){return 1}\n"},
    {"action": "write", "path": "$work/numbered/1_duplicate.ts", "text": "export function leaf(){return 1}\n"},
    {"action": "write", "path": "$work/numbered/2_duplicate.ts", "text": "export function leaf(){return 1}\n"},
    {"action": "write", "path": "$work/numbered/9_blocked.ts", "text": "export function leaf(){return 1}\n"},
    {"action": "write", "path": "$work/numbered/0_blocked.ts", "text": "export function leaf(){return 1}\n"},
    {"action": "write", "path": "$work/numbered/8_directory.ts", "text": "export function leaf(){return 1}\n"},
    {"action": "directory", "path": "$work/numbered/0_directory.ts"},
    {"action": "command", "arguments": ["stratify", "--from", "0_log.ts", "--from", "4_jsxAuto.test.ts", "--from", "2a_Signal.browser.test.ts", "--from", "10_history.memory.ts", "--from", "3_plain.tsx", "--from", "1_duplicate.ts", "--from", "2_duplicate.ts", "--from", "9_blocked.ts", "--from", "8_directory.ts", "--root", "$work/numbered", "."], "cwd": "$work/numbered", "capture": "numbered_first", "unasserted_stderr": true},
    {"action": "command", "arguments": ["stratify", "--from", "0_log.ts", "--from", "4_jsxAuto.test.ts", "--from", "2a_Signal.browser.test.ts", "--from", "10_history.memory.ts", "--from", "3_plain.tsx", "--from", "1_duplicate.ts", "--from", "2_duplicate.ts", "--from", "9_blocked.ts", "--from", "8_directory.ts", "--root", "$work/numbered", "."], "cwd": "$work/numbered", "capture": "numbered_second", "unasserted_stderr": true},
    {"action": "claim", "name": "numbered_runs_agree", "kind": "cells_equal", "left": "numbered_first.stdout", "right": "numbered_second.stdout"},
    {"action": "claim", "name": "numbered_move_rows", "kind": "count_substring", "cell": "numbered_first.stdout", "text": "\"record\":\"stratify_move\"", "expect": 5},
    {"action": "claim", "name": "numbered_log_target", "kind": "json_scalar", "cell": "numbered_first.stdout", "line_contains": "\"from_path\":\"0_log.ts\"", "pointer": "to_path", "expect": "0_log.ts"},
    {"action": "claim", "name": "numbered_history_target", "kind": "json_scalar", "cell": "numbered_first.stdout", "line_contains": "\"from_path\":\"10_history.memory.ts\"", "pointer": "to_path", "expect": "0_history.memory.ts"},
    {"action": "claim", "name": "numbered_jsx_reason", "kind": "json_scalar", "cell": "numbered_first.stdout", "line_contains": "\"from_path\":\"4_jsxAuto.test.ts\"", "pointer": "reason", "expect": "depth_prefix"},
    {"action": "claim", "name": "numbered_plain_target", "kind": "json_scalar", "cell": "numbered_first.stdout", "line_contains": "\"from_path\":\"3_plain.tsx\"", "pointer": "to_path", "expect": "0_plain.tsx"},
    {"action": "claim", "name": "numbered_signal_target", "kind": "json_scalar", "cell": "numbered_first.stdout", "line_contains": "\"from_path\":\"2a_Signal.browser.test.ts\"", "pointer": "to_path", "expect": "0_Signal.browser.test.ts"}
  ]
}
