{
  "steps": [
    {
      "action": "run",
      "name": "cli",
      "arguments": [
        "--resolve",
        "tests/fixtures/resolve/0_caller.ts",
        "tests/fixtures/resolve/1_callee.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "reach",
      "kind": "line_matches",
      "cell": "cli",
      "texts": [
        "\"record\":\"resolved_edge\""
      ]
    },
    {
      "action": "run",
      "name": "without",
      "arguments": [
        "tests/fixtures/resolve/0_caller.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "flag_required",
      "kind": "no_line_matches",
      "cell": "without",
      "texts": [
        "\"record\":\"resolved_edge\""
      ]
    }
  ]
}
