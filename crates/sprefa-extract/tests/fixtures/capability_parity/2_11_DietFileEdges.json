{
  "steps": [
    {
      "action": "run",
      "name": "cli",
      "arguments": [
        "--deps",
        "--root",
        "tests/fixtures/capability_parity/inputs/3_deps",
        "tests/fixtures/capability_parity/inputs/3_deps/0_app.ts",
        "tests/fixtures/capability_parity/inputs/3_deps/1_lib.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "reach",
      "kind": "line_matches",
      "cell": "cli",
      "texts": [
        "\"record\":\"file_edge\""
      ]
    },
    {
      "action": "run",
      "name": "without",
      "arguments": [
        "tests/fixtures/capability_parity/inputs/3_deps/0_app.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "flag_required",
      "kind": "no_line_matches",
      "cell": "without",
      "texts": [
        "\"record\":\"file_edge\""
      ]
    }
  ]
}
