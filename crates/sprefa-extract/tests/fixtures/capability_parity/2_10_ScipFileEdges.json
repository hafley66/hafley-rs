{
  "steps": [
    {
      "action": "api",
      "name": "ts_index0",
      "api": "scip_index",
      "root": "tests/fixtures/capability_parity/inputs/2_scip",
      "into": "$work/ts0.scip"
    },
    {
      "action": "run",
      "name": "cli",
      "arguments": [
        "--scip-deps",
        "--root",
        "tests/fixtures/capability_parity/inputs/2_scip",
        "--scip-index",
        "$work/ts0.scip",
        "tests/fixtures/capability_parity/inputs/2_scip/alpha.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "reach",
      "kind": "line_matches",
      "cell": "cli",
      "texts": [
        "\"record\":\"file_edge\""
      ]
    },
    {
      "action": "run",
      "name": "without",
      "arguments": [
        "tests/fixtures/capability_parity/inputs/2_scip/gamma.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "flag_required",
      "kind": "no_line_matches",
      "cell": "without",
      "texts": [
        "\"record\":\"file_edge\""
      ]
    }
  ]
}
