{
  "steps": [
    {
      "action": "run",
      "name": "cli",
      "arguments": [
        "--package-deps",
        "--root",
        "tests/fixtures/packages",
        "tests/fixtures/packages/crates/alpha/Cargo.toml",
        "tests/fixtures/packages/crates/beta/Cargo.toml"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "reach",
      "kind": "line_matches",
      "cell": "cli",
      "texts": [
        "\"record\":\"package_edge\""
      ]
    },
    {
      "action": "run",
      "name": "without",
      "arguments": [
        "--deps",
        "--root",
        "tests/fixtures/deps",
        "tests/fixtures/deps/app.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "flag_required",
      "kind": "no_line_matches",
      "cell": "without",
      "texts": [
        "\"record\":\"package_edge\""
      ]
    }
  ]
}
