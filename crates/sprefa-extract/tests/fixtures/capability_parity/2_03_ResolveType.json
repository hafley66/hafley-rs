        "--arms",
        "type",
        "tests/fixtures/capability_parity/inputs/1_resolve/0_owner.ts",
        "tests/fixtures/capability_parity/inputs/1_resolve/1_item.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": ",\"(?:index_mtime_unix_ms|staleness|reused)\":(?:[0-9]+|\"(?:[^\"\\\\]|\\\\.)*\"|true|false)",
          "replacement": ""
