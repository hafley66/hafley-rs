{
  "steps": [
    {
      "action": "run",
      "name": "cli",
      "arguments": [
        "scip",
        "--raw",
        "--root",
        "tests/fixtures/scip_rel",
        "--scip-build",
        "tests/fixtures/scip_rel/animal.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "reach",
      "kind": "line_matches",
      "cell": "cli",
      "texts": [
        "\"record\":\"scip_relationship\""
      ]
    },
    {
      "action": "run",
      "name": "without",
      "arguments": [
        "tests/fixtures/scip_rel/animal.ts"
      ],
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "flag_required",
      "kind": "no_line_matches",
      "cell": "without",
      "texts": [
        "\"record\":\"scip_relationship\""
      ]
    }
  ]
}
