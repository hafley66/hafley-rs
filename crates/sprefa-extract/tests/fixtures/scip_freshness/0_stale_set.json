{
  "steps": [
    {
      "action": "write",
      "path": "$work/root/.dl/.state/index.scip",
      "text": "not a real index, only a path to find"
    },
    {
      "action": "api",
      "name": "built",
      "api": "define_set",
      "entries": [
        [
          "a.rs",
          "digest-a"
        ],
        [
          "b.rs",
          "digest-b"
        ]
      ]
    },
    {
      "action": "api",
      "name": "record",
      "api": "record_set",
      "index": "$work/root/.dl/.state/index.scip",
      "set": "built"
    },
    {
      "action": "api",
      "name": "matching",
      "api": "lookup",
      "root": "$work/root",
      "cache": "$work/root/.dl/.state",
      "set": "built",
      "expect": "$work/root/.dl/.state/index.scip"
    },
    {
      "action": "api",
      "name": "moved",
      "api": "define_set",
      "entries": [
        [
          "a.rs",
          "digest-a"
        ],
        [
          "b.rs",
          "digest-b-MOVED"
        ]
      ]
    },
    {
      "action": "api",
      "name": "digest_changed",
      "api": "digest_compare",
      "left": "built",
      "right": "moved",
      "expect": false
    },
    {
      "action": "api",
      "name": "stale",
      "api": "lookup",
      "root": "$work/root",
      "cache": "$work/root/.dl/.state",
      "set": "moved",
      "expect": null
    },
    {
      "action": "api",
      "name": "original",
      "api": "lookup",
      "root": "$work/root",
      "cache": "$work/root/.dl/.state",
      "set": "built",
      "expect": "$work/root/.dl/.state/index.scip"
    },
    {
      "action": "api",
      "name": "legacy",
      "api": "legacy_lookup",
      "root": "$work/root",
      "cache": "$work/root/.dl/.state",
      "set": null,
      "expect": "$work/root/.dl/.state/index.scip"
    }
  ]
}
