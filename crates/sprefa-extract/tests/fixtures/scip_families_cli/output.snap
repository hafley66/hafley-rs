  "20_the_roster_carries_v5s_six_languages": {
    "roster": [
      {
        "language": "rust",
        "binary": "rust-analyzer",
        "source_binary": "rust-analyzer",
        "markers": [
          "Cargo.toml"
        ],
        "install": "rustup component add rust-analyzer"
      },
      {
        "language": "typescript",
        "binary": "scip-typescript",
        "source_binary": "scip-typescript",
        "markers": [
          "tsconfig.json",
          "package.json"
        ],
        "install": "npm install -g @sourcegraph/scip-typescript"
      },
      {
        "language": "python",
        "binary": "scip-python",
        "source_binary": "scip-python",
