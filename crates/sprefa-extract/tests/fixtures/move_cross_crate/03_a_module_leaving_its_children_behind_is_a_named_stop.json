{
  "steps": [
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "copy_tree",
      "source": "$fixtures/rust_cross",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/repo/alpha/src/shapes"
    },
    {
      "action": "write",
      "path": "$work/repo/alpha/src/shapes/inner.rs",
      "text": "pub fn depth() -> u32 {\n    1\n}\n"
    },
    {
      "action": "write",
      "path": "$work/repo/alpha/src/shapes.rs",
      "text": "pub mod inner;\n\npub struct Circle;\n\npub fn area(_: &Circle) -> f64 {\n    0.0\n}\n\npub fn perimeter(_: f64) -> f64 {\n    0.0\n}\n"
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "init",
        "-q",
        "."
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "-c",
        "user.email=ryi@cross.test",
        "-c",
        "user.name=ryi-cross",
        "commit",
        "-qm",
        "fixture"
      ]
    },
    {
      "action": "run",
      "name": "command",
      "arguments": [
        "move",
        "$work/repo/alpha/src/shapes.rs",
        "$work/repo/beta/src/shapes.rs",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "environment": {
        "RUST_LOG": "warn",
        "RUSTUP_TOOLCHAIN": "stable"
      },
      "expect_exit_code": 2,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^((?:\\[root [^\\n]+?\\] )?stage )[0-9a-f]{64}(.*)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    }
  ]
}
