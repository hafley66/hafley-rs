{
  "steps": [
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "copy_tree",
      "source": "$fixtures/rust_cross",
      "target": "$work/repo"
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "init",
        "-q",
        "."
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "-c",
        "user.email=ryi@cross.test",
        "-c",
        "user.name=ryi-cross",
        "commit",
        "-qm",
        "fixture"
      ]
    },
    {
      "action": "run",
      "name": "command",
      "arguments": [
        "cleave",
        "$work/repo/alpha/src/shapes.rs#perimeter",
        "$work/repo/beta/src/4_round.rs",
        "--commit",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "environment": {
        "RUST_LOG": "warn",
        "RUSTUP_TOOLCHAIN": "stable"
      },
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^((?:\\[root [^\\n]+?\\] )?stage )[0-9a-f]{64}(.*)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "file_equals",
      "name": "file_0",
      "path": "$work/repo/beta/src/lib.rs",
      "text": "pub mod base;\n#[path = \"4_round.rs\"] pub mod round;\n"
    },
    {
      "action": "read_tree",
      "name": "projected_file_0",
      "path": "$work/repo/alpha/src/util.rs"
    },
    {
      "action": "run",
      "name": "cargo_check",
      "program": "$cargo",
      "arguments": [
        "check",
        "--offline",
        "-q"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/repo/target",
        "KACHE_DISABLED": "1",
        "RUSTUP_TOOLCHAIN": "stable"
      },
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    }
  ]
}
