{
  "steps": [
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "copy_tree",
      "source": "$fixtures/rust_cross",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/repo/alpha/src/shapes"
    },
    {
      "action": "write",
      "path": "$work/repo/alpha/src/shapes/inner.rs",
      "text": "pub(crate) fn depth() -> u32 {\n    super::super::shapes::perimeter(1.0) as u32\n}\n"
    },
    {
      "action": "write",
      "path": "$work/repo/alpha/src/shapes.rs",
      "text": "pub mod inner;\n\npub struct Circle {\n    pub(crate) radius: f64,\n}\n\nimpl Circle {\n    pub(crate) fn new(radius: f64) -> Self {\n        Circle { radius }\n    }\n}\n\npub(crate) fn area(circle: &Circle) -> f64 {\n    circle.radius * f64::from(inner::depth())\n}\n\npub fn perimeter(radius: f64) -> f64 {\n    radius * 6.0\n}\n"
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "init",
        "-q",
        "."
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "add",
        "-A"
      ]
    },
    {
      "action": "git",
      "cwd": "$work/repo",
      "args": [
        "-c",
        "user.email=ryi@cross.test",
        "-c",
        "user.name=ryi-cross",
        "commit",
        "-qm",
        "fixture"
      ]
    },
    {
      "action": "write",
      "path": "$work/state/moves.tsv",
      "text": "$work/repo/alpha/src/shapes.rs\t$work/repo/beta/src/shapes.rs\n$work/repo/alpha/src/shapes/inner.rs\t$work/repo/beta/src/shapes/inner.rs\n"
    },
    {
      "action": "run",
      "name": "command",
      "arguments": [
        "move",
        "--list",
        "$work/state/moves.tsv",
        "--commit",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "environment": {
        "RUST_LOG": "warn",
        "RUSTUP_TOOLCHAIN": "stable"
      },
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^((?:\\[root [^\\n]+?\\] )?stage )[0-9a-f]{64}(.*)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "file_equals",
      "name": "file_0",
      "path": "$work/repo/beta/src/lib.rs",
      "text": "pub mod base;\npub mod shapes;\n"
    },
    {
      "action": "file_equals",
      "name": "file_1",
      "path": "$work/repo/beta/src/shapes/inner.rs",
      "text": "pub(crate) fn depth() -> u32 {\n    super::super::shapes::perimeter(1.0) as u32\n}\n"
    },
    {
      "action": "read_tree",
      "name": "projected_file_0",
      "path": "$work/repo/beta/src/shapes.rs"
    },
    {
      "action": "run",
      "name": "cargo_check",
      "program": "$cargo",
      "arguments": [
        "check",
        "--offline",
        "-q"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/repo/target",
        "KACHE_DISABLED": "1",
        "RUSTUP_TOOLCHAIN": "stable"
      },
      "expect_exit_code": 0,
      "raw_stdout": true,
      "unasserted_stdout": true,
      "unasserted_stderr": true
    }
  ]
}
