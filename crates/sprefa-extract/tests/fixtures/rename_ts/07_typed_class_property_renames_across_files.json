{
  "claim_test": "typed_class_property_renames_across_files",
  "steps": [
    {
      "action": "directory",
      "name": "state",
      "path": "$work/state"
    },
    {
      "action": "copy",
      "name": "copy_src_box.ts",
      "source": "tests/fixtures/ts_rename/property/before/src/box.ts",
      "path": "$work/repo/src/box.ts"
    },
    {
      "action": "copy",
      "name": "copy_src_use.ts",
      "source": "tests/fixtures/ts_rename/property/before/src/use.ts",
      "path": "$work/repo/src/use.ts"
    },
    {
      "action": "api",
      "name": "scip_index",
      "api": "scip_index",
      "root": "$work/repo",
      "into": "$work/ts.index"
    },
    {
      "action": "run",
      "name": "commit",
      "arguments": [
        "rename",
        "src/box.ts#old",
        "fresh",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--verify-scip",
        "$work/ts.index",
        "--commit"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/repo",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "read_tree",
      "name": "box_text",
      "path": "$work/repo/src/box.ts"
    },
    {
      "action": "read_tree",
      "name": "use_text",
      "path": "$work/repo/src/use.ts"
    }
  ]
}
