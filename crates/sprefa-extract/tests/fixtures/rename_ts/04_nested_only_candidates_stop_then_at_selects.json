{
  "claim_test": "nested_only_candidates_stop_then_at_selects",
  "steps": [
    {
      "action": "directory",
      "name": "state",
      "path": "$work/state"
    },
    {
      "action": "copy",
      "name": "copy_src_app.ts",
      "source": "tests/fixtures/ts_rename/stops/nested_ambiguous/before/src/app.ts",
      "path": "$work/repo/src/app.ts"
    },
    {
      "action": "run",
      "name": "stopped",
      "arguments": [
        "rename",
        "src/app.ts#Foo",
        "Bar",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "success": false,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/repo",
      "raw_stdout": true,
      "expect_exit_code": 3,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "tree_matches",
      "name": "stopped_tree",
      "left": "$work/repo",
      "fixture": "tests/fixtures/ts_rename/stops/nested_ambiguous/before"
    },
    {
      "action": "directory",
      "name": "state",
      "path": "$work/state"
    },
    {
      "action": "copy",
      "name": "copy_src_app.ts",
      "source": "tests/fixtures/ts_rename/stops/nested_ambiguous/before/src/app.ts",
      "path": "$work/repo/src/app.ts"
    },
    {
      "action": "run",
      "name": "select",
      "arguments": [
        "rename",
        "src/app.ts#Foo",
        "Bar",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--at",
        "101",
        "--commit"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/repo",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "tree_matches",
      "name": "select_tree",
      "left": "$work/repo",
      "fixture": "tests/fixtures/ts_rename/stops/nested_ambiguous/after"
    }
  ]
}
