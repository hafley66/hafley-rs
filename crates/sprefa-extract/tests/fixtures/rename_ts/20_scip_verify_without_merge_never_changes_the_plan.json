{
  "claim_test": "scip_verify_without_merge_never_changes_the_plan",
  "steps": [
    {
      "action": "directory",
      "name": "state_verified",
      "path": "$work/state_verified"
    },
    {
      "action": "copy",
      "name": "copy_verified_tsconfig.json",
      "source": "tests/fixtures/ts_rename/exports/before/tsconfig.json",
      "path": "$work/verified/tsconfig.json"
    },
    {
      "action": "copy",
      "name": "copy_verified_README.md",
      "source": "tests/fixtures/ts_rename/exports/before/README.md",
      "path": "$work/verified/README.md"
    },
    {
      "action": "copy",
      "name": "copy_verified_src_a.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/a.ts",
      "path": "$work/verified/src/a.ts"
    },
    {
      "action": "copy",
      "name": "copy_verified_src_b.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/b.ts",
      "path": "$work/verified/src/b.ts"
    },
    {
      "action": "copy",
      "name": "copy_verified_src_barrel.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/barrel.ts",
      "path": "$work/verified/src/barrel.ts"
    },
    {
      "action": "copy",
      "name": "copy_verified_src_c.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/c.ts",
      "path": "$work/verified/src/c.ts"
    },
    {
      "action": "copy",
      "name": "copy_verified_src_d.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/d.ts",
      "path": "$work/verified/src/d.ts"
    },
    {
      "action": "copy",
      "name": "copy_verified_src_e.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/e.ts",
      "path": "$work/verified/src/e.ts"
    },
    {
      "action": "copy",
      "name": "copy_verified_src_lib.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/lib.ts",
      "path": "$work/verified/src/lib.ts"
    },
    {
      "action": "copy",
      "name": "copy_verified_src_star.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/star.ts",
      "path": "$work/verified/src/star.ts"
    },
    {
      "action": "write",
      "name": "write_ns_verified",
      "path": "$work/verified/src/ns.ts",
      "text": "import * as lib from \"./lib\";\n\nexport function viaNamespace(): lib.Foo {\n  return new lib.Foo();\n}\n"
    },
    {
      "action": "directory",
      "name": "state_plain",
      "path": "$work/state_plain"
    },
    {
      "action": "copy",
      "name": "copy_plain_tsconfig.json",
      "source": "tests/fixtures/ts_rename/exports/before/tsconfig.json",
      "path": "$work/plain/tsconfig.json"
    },
    {
      "action": "copy",
      "name": "copy_plain_README.md",
      "source": "tests/fixtures/ts_rename/exports/before/README.md",
      "path": "$work/plain/README.md"
    },
    {
      "action": "copy",
      "name": "copy_plain_src_a.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/a.ts",
      "path": "$work/plain/src/a.ts"
    },
    {
      "action": "copy",
      "name": "copy_plain_src_b.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/b.ts",
      "path": "$work/plain/src/b.ts"
    },
    {
      "action": "copy",
      "name": "copy_plain_src_barrel.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/barrel.ts",
      "path": "$work/plain/src/barrel.ts"
    },
    {
      "action": "copy",
      "name": "copy_plain_src_c.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/c.ts",
      "path": "$work/plain/src/c.ts"
    },
    {
      "action": "copy",
      "name": "copy_plain_src_d.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/d.ts",
      "path": "$work/plain/src/d.ts"
    },
    {
      "action": "copy",
      "name": "copy_plain_src_e.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/e.ts",
      "path": "$work/plain/src/e.ts"
    },
    {
      "action": "copy",
      "name": "copy_plain_src_lib.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/lib.ts",
      "path": "$work/plain/src/lib.ts"
    },
    {
      "action": "copy",
      "name": "copy_plain_src_star.ts",
      "source": "tests/fixtures/ts_rename/exports/before/src/star.ts",
      "path": "$work/plain/src/star.ts"
    },
    {
      "action": "write",
      "name": "write_ns_plain",
      "path": "$work/plain/src/ns.ts",
      "text": "import * as lib from \"./lib\";\n\nexport function viaNamespace(): lib.Foo {\n  return new lib.Foo();\n}\n"
    },
    {
      "action": "api",
      "name": "scip_index",
      "api": "scip_index",
      "root": "$work/verified",
      "into": "$work/ts.index"
    },
    {
      "action": "run",
      "name": "with",
      "arguments": [
        "rename",
        "src/lib.ts#Foo",
        "Baz",
        "--root",
        "$work/verified",
        "--state",
        "$work/state_verified",
        "--verify-scip",
        "$work/ts.index",
        "--no-scip-merge",
        "--commit"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/verified",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "run",
      "name": "without",
      "arguments": [
        "rename",
        "src/lib.ts#Foo",
        "Baz",
        "--root",
        "$work/plain",
        "--state",
        "$work/state_plain",
        "--commit"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/plain",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "compare",
      "name": "plan_unchanged",
      "left": "with",
      "right": "without",
      "projection": "plan_lines"
    },
    {
      "action": "compare",
      "name": "verified_rows",
      "left": "with",
      "projection": "prefix",
      "prefix": "scip-verify ",
      "text": "scip-verify src/ns.ts:67-70 scip-only\nscip-verify src/ns.ts:90-93 scip-only\nscip-verify disagreements=2\n"
    },
    {
      "action": "compare",
      "name": "plain_rows_silent",
      "left": "without",
      "projection": "prefix",
      "prefix": "scip-verify ",
      "text": ""
    },
    {
      "action": "tree_matches",
      "name": "trees_identical",
      "left": "$work/verified",
      "right": "$work/plain"
    }
  ]
}
