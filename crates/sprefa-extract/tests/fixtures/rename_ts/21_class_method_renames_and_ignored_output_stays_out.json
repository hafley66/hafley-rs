{
  "claim_test": "class_method_renames_and_ignored_output_stays_out",
  "steps": [
    {
      "action": "directory",
      "name": "state",
      "path": "$work/state"
    },
    {
      "action": "copy",
      "name": "copy_.gitignore",
      "source": "tests/fixtures/ts_rename/method/before/.gitignore",
      "path": "$work/repo/.gitignore"
    },
    {
      "action": "copy",
      "name": "copy_dist_box.js",
      "source": "tests/fixtures/ts_rename/method/before/dist/box.js",
      "path": "$work/repo/dist/box.js"
    },
    {
      "action": "copy",
      "name": "copy_src_box.ts",
      "source": "tests/fixtures/ts_rename/method/before/src/box.ts",
      "path": "$work/repo/src/box.ts"
    },
    {
      "action": "copy",
      "name": "copy_src_use.ts",
      "source": "tests/fixtures/ts_rename/method/before/src/use.ts",
      "path": "$work/repo/src/use.ts"
    },
    {
      "action": "run",
      "name": "git_init",
      "arguments": [
        "init",
        "-q",
        "."
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null"
      },
      "cwd": "$work/repo",
      "program": "git",
      "raw_stdout": true
    },
    {
      "action": "run",
      "name": "git_add",
      "arguments": [
        "add",
        "src",
        ".gitignore"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null"
      },
      "cwd": "$work/repo",
      "program": "git",
      "raw_stdout": true
    },
    {
      "action": "run",
      "name": "git_commit",
      "arguments": [
        "-c",
        "user.email=t@t",
        "-c",
        "user.name=t",
        "commit",
        "-qm",
        "fixture"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_CONFIG_SYSTEM": "/dev/null"
      },
      "cwd": "$work/repo",
      "program": "git",
      "raw_stdout": true
    },
    {
      "action": "run",
      "name": "rename",
      "arguments": [
        "rename",
        "src/box.ts#run",
        "execute",
        "--commit",
        "--state",
        "$work/state"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/repo",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "read_tree",
      "name": "box_text",
      "path": "$work/repo/src/box.ts"
    },
    {
      "action": "read_tree",
      "name": "use_text",
      "path": "$work/repo/src/use.ts"
    },
    {
      "action": "read_tree",
      "name": "dist_text",
      "path": "$work/repo/dist/box.js"
    }
  ]
}
