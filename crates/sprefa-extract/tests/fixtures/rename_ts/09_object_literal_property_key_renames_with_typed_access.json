{
  "claim_test": "object_literal_property_key_renames_with_typed_access",
  "steps": [
    {
      "action": "directory",
      "name": "state",
      "path": "$work/state"
    },
    {
      "action": "copy",
      "name": "copy_src_app.ts",
      "source": "tests/fixtures/ts_rename/object_property/before/src/app.ts",
      "path": "$work/repo/src/app.ts"
    },
    {
      "action": "run",
      "name": "commit",
      "arguments": [
        "rename",
        "src/app.ts#old",
        "fresh",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/repo",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "read_tree",
      "name": "app_text",
      "path": "$work/repo/src/app.ts"
    }
  ]
}
