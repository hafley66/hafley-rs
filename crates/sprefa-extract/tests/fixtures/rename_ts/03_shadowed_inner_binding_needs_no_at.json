{
  "claim_test": "shadowed_inner_binding_needs_no_at",
  "steps": [
    {
      "action": "directory",
      "name": "state",
      "path": "$work/state"
    },
    {
      "action": "copy",
      "name": "copy_src_app.ts",
      "source": "tests/fixtures/ts_rename/stops/ambiguous/before/src/app.ts",
      "path": "$work/repo/src/app.ts"
    },
    {
      "action": "run",
      "name": "root_wins",
      "arguments": [
        "rename",
        "src/app.ts#Foo",
        "Bar",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/repo",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "tree_matches",
      "name": "root_wins_tree",
      "left": "$work/repo",
      "fixture": "tests/fixtures/ts_rename/stops/ambiguous/after"
    },
    {
      "action": "directory",
      "name": "state",
      "path": "$work/state"
    },
    {
      "action": "copy",
      "name": "copy_src_app.ts",
      "source": "tests/fixtures/ts_rename/stops/ambiguous/before/src/app.ts",
      "path": "$work/repo/src/app.ts"
    },
    {
      "action": "run",
      "name": "picked",
      "arguments": [
        "rename",
        "src/app.ts#Foo",
        "Bar",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--at",
        "90",
        "--commit"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/repo",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "read_tree",
      "name": "picked_anchor_text",
      "path": "$work/repo/src/app.ts"
    }
  ]
}
