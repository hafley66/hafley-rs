{
  "claim_test": "inexact_is_unreachable_from_the_ts_arm",
  "steps": [
    {
      "action": "api",
      "name": "inexact_unconstructed",
      "api": "source_absent",
      "path": "src/edit/ts_rename.rs",
      "needle": "Inexact"
    },
    {
      "action": "directory",
      "name": "state",
      "path": "$work/state"
    },
    {
      "action": "copy",
      "name": "copy_src_app.ts",
      "source": "tests/fixtures/ts_rename/stops/inexact/before/src/app.ts",
      "path": "$work/repo/src/app.ts"
    },
    {
      "action": "run",
      "name": "commit",
      "arguments": [
        "rename",
        "src/app.ts#Foo",
        "Bar",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/repo",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "tree_matches",
      "name": "tree",
      "left": "$work/repo",
      "fixture": "tests/fixtures/ts_rename/stops/inexact/after"
    }
  ]
}
