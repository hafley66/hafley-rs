{
  "claim_test": "dry_run_touches_nothing",
  "steps": [
    {
      "action": "directory",
      "name": "state",
      "path": "$work/state"
    },
    {
      "action": "copy",
      "name": "copy_src_app.ts",
      "source": "tests/fixtures/ts_rename/local/before/src/app.ts",
      "path": "$work/repo/src/app.ts"
    },
    {
      "action": "run",
      "name": "dry",
      "arguments": [
        "rename",
        "src/app.ts#oldName",
        "newName",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "success": true,
      "environment": {
        "RUST_LOG": "off",
        "DL_TRACE": "0",
        "DL_TRAIL": "0"
      },
      "cwd": "$work/repo",
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "tree_matches",
      "name": "tree",
      "left": "$work/repo",
      "fixture": "tests/fixtures/ts_rename/local/before"
    }
  ]
}
