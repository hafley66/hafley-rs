    "tree": {
      "files": {
        "README.md": "# exports fixture\n\nThe Foo symbol exported by src/lib.ts is renamed across this fixture by the\ntests in 4_rename_ts.rs; this file carries a prose mention of the name so the\nrename verb's --text-refs report sees a carrier outside any source file.\n",
        "src/": {
          "directory": true
        },
        "src/a.ts": "import { Baz } from \"./lib\";\n\nexport function firstUse(value: Baz): Baz {\n  return value;\n}\n",
        "src/b.ts": "import { Baz as Bar } from \"./lib\";\n\nexport function secondUse(left: Bar, right: Bar): Bar {\n  return left.tag === right.tag ? left : right;\n}\n",
        "src/barrel.ts": "export { Baz } from \"./lib\";\n",
        "src/c.ts": "import { Baz } from \"./barrel\";\n\nexport function fromBarrel(value: Baz): string {\n  return value.tag;\n}\n",
        "src/d.ts": "import { Baz } from \"./star\";\n\nexport function viaStar(value: Baz): boolean {\n  return value.tag === \"foo\";\n}\n",
        "src/e.ts": "export const key = \"Foo\";\n",
        "src/lib.ts": "export class Baz {\n  readonly tag = \"foo\";\n}\n\nexport function makeFoo(): Baz {\n  return new Baz();\n}\n",
        "src/star.ts": "export * from \"./lib\";\n",
        "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"bundler\",\n    \"strict\": true,\n    \"noEmit\": true\n  },\n  \"include\": [\"src\"]\n}\n"
      }
    }
