{
  "tests": [
    "three_moves_touching_one_importer_are_three_edits_in_one_replace",
    "a_batch_dry_run_prints_one_plan_and_writes_nothing",
    "a_mixed_list_picks_an_arm_per_row_by_extension",
    "a_destination_that_another_row_still_reads_from_ends_the_run",
    "two_rows_writing_one_destination_end_the_run",
    "a_row_with_no_tab_ends_the_run_instead_of_being_skipped",
    "the_list_and_the_positional_form_are_exclusive",
    "a_replace_whose_file_changed_under_it_is_refused"
  ],
  "steps": [
    {"action": "write", "path": "$work/shared/repo/src/a.ts", "text": "export const a = 'a';\n"},
    {"action": "write", "path": "$work/shared/repo/src/b.ts", "text": "export const b = 'b';\n"},
    {"action": "write", "path": "$work/shared/repo/src/c.ts", "text": "export const c = 'c';\n"},
    {"action": "write", "path": "$work/shared/repo/src/hub.ts", "text": "import { a } from './a';\nimport { b } from './b';\nimport { c } from './c';\n\nexport const hub = [a, b, c];\n"},
    {"action": "write", "path": "$work/shared/repo/src/onlyA.ts", "text": "import { a } from './a';\n\nexport const onlyA = a;\n"},
    {"action": "directory", "path": "$work/shared/state"},
    {"action": "git", "args": ["init", "-q", "."], "cwd": "$work/shared/repo"},
    {"action": "git", "args": ["add", "-A"], "cwd": "$work/shared/repo"},
    {"action": "git", "args": ["-c", "user.email=extract@move.test", "-c", "user.name=extract-move", "commit", "-qm", "fixture"], "cwd": "$work/shared/repo"},
    {"action": "write", "path": "$work/shared/state/moves.tsv", "text": "# three files leave src/ for lib/\n\nsrc/a.ts\tlib/a.ts\nsrc/b.ts\tlib/b.ts\nsrc/c.ts\tlib/c.ts\n"},
    {"action": "command", "arguments": ["move", "--list", "$work/shared/state/moves.tsv", "--root", "$work/shared/repo", "--state", "$work/shared/state", "--commit"], "cwd": "$work/shared/repo", "raw_stdout": true, "capture": "shared_commit", "stdout_redactions": [{"pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$", "replacement": "${1}$$STAGE${2}"}]},
    {"action": "claim", "name": "shared_moves", "kind": "line_count", "cell": "shared_commit.stdout", "line_prefix": "move ", "expect": 3},
    {"action": "claim", "name": "shared_replaces", "kind": "line_count", "cell": "shared_commit.stdout", "line_prefix": "replace ", "expect": 2},
    {"action": "claim", "name": "shared_stages", "kind": "count_substring", "cell": "shared_commit.stdout", "text": "committed", "expect": 2},
    {"action": "file_equals", "path": "$work/shared/repo/src/hub.ts", "text": "import { a } from '../lib/a';\nimport { b } from '../lib/b';\nimport { c } from '../lib/c';\n\nexport const hub = [a, b, c];\n", "capture": "shared_hub"},
    {"action": "file_equals", "path": "$work/shared/repo/src/onlyA.ts", "text": "import { a } from '../lib/a';\n\nexport const onlyA = a;\n", "capture": "shared_onlyA"},
    {"action": "exists", "path": "$work/shared/repo/lib/a.ts", "kind": "file", "expected": true, "name": "shared_lib_a"},
    {"action": "exists", "path": "$work/shared/repo/lib/b.ts", "kind": "file", "expected": true, "name": "shared_lib_b"},
    {"action": "exists", "path": "$work/shared/repo/lib/c.ts", "kind": "file", "expected": true, "name": "shared_lib_c"},
    {"action": "exists", "path": "$work/shared/repo/src/a.ts", "expected": false, "name": "shared_src_a_gone"},

    {"action": "write", "path": "$work/dry/repo/src/a.ts", "text": "export const a = 'a';\n"},
    {"action": "write", "path": "$work/dry/repo/src/b.ts", "text": "export const b = 'b';\n"},
    {"action": "write", "path": "$work/dry/repo/src/c.ts", "text": "export const c = 'c';\n"},
    {"action": "write", "path": "$work/dry/repo/src/hub.ts", "text": "import { a } from './a';\nimport { b } from './b';\nimport { c } from './c';\n\nexport const hub = [a, b, c];\n"},
    {"action": "write", "path": "$work/dry/repo/src/onlyA.ts", "text": "import { a } from './a';\n\nexport const onlyA = a;\n"},
    {"action": "directory", "path": "$work/dry/state"},
    {"action": "git", "args": ["init", "-q", "."], "cwd": "$work/dry/repo"},
    {"action": "git", "args": ["add", "-A"], "cwd": "$work/dry/repo"},
    {"action": "git", "args": ["-c", "user.email=extract@move.test", "-c", "user.name=extract-move", "commit", "-qm", "fixture"], "cwd": "$work/dry/repo"},
    {"action": "write", "path": "$work/dry/state/moves.tsv", "text": "# three files leave src/ for lib/\n\nsrc/a.ts\tlib/a.ts\nsrc/b.ts\tlib/b.ts\nsrc/c.ts\tlib/c.ts\n"},
    {"action": "command", "arguments": ["move", "--list", "$work/dry/state/moves.tsv", "--root", "$work/dry/repo", "--state", "$work/dry/state"], "cwd": "$work/dry/repo", "raw_stdout": true, "capture": "dry_plan", "stdout_redactions": [{"pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$", "replacement": "${1}$$STAGE${2}"}]},
    {"action": "claim", "name": "dry_moves", "kind": "line_count", "cell": "dry_plan.stdout", "line_prefix": "move ", "expect": 3},
    {"action": "claim", "name": "dry_replaces", "kind": "line_count", "cell": "dry_plan.stdout", "line_prefix": "replace ", "expect": 2},
    {"action": "claim", "name": "dry_markers", "kind": "count_substring", "cell": "dry_plan.stdout", "text": "dry run, tree untouched", "expect": 2},
    {"action": "claim", "name": "dry_plan_lines", "kind": "line_count", "cell": "dry_plan.stdout", "line_prefix": "plan ", "expect": 3},
    {"action": "command", "program": "git", "arguments": ["status", "--porcelain"], "cwd": "$work/dry/repo", "raw_stdout": true, "capture": "dry_status"},
    {"action": "claim", "name": "dry_status_empty", "kind": "text_equals", "cell": "dry_status.stdout", "text": ""},
    {"action": "file_equals", "path": "$work/dry/repo/src/hub.ts", "text": "import { a } from './a';\nimport { b } from './b';\nimport { c } from './c';\n\nexport const hub = [a, b, c];\n", "capture": "dry_hub_unchanged"},

    {"action": "write", "path": "$work/mixed/repo/a.pl", "text": ":- module(a, [check/0]).\n:- use_module('lib/b').\n\ncheck :- true.\n"},
    {"action": "write", "path": "$work/mixed/repo/lib/b.pl", "text": ":- module(b, []).\n"},
    {"action": "write", "path": "$work/mixed/repo/src/x.ts", "text": "export const x = 'x';\n"},
    {"action": "write", "path": "$work/mixed/repo/src/user.ts", "text": "import { x } from './x';\n\nexport const user = x;\n"},
    {"action": "directory", "path": "$work/mixed/state"},
    {"action": "git", "args": ["init", "-q", "."], "cwd": "$work/mixed/repo"},
    {"action": "git", "args": ["add", "-A"], "cwd": "$work/mixed/repo"},
    {"action": "git", "args": ["-c", "user.email=extract@move.test", "-c", "user.name=extract-move", "commit", "-qm", "fixture"], "cwd": "$work/mixed/repo"},
    {"action": "write", "path": "$work/mixed/state/moves.tsv", "text": "lib/b.pl\tcore/b.pl\nsrc/x.ts\tsrc/deep/x.ts\n"},
    {"action": "command", "arguments": ["move", "--list", "$work/mixed/state/moves.tsv", "--root", "$work/mixed/repo", "--state", "$work/mixed/state", "--commit"], "cwd": "$work/mixed/repo", "raw_stdout": true, "capture": "mixed_commit", "stdout_redactions": [{"pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$", "replacement": "${1}$$STAGE${2}"}]},
    {"action": "claim", "name": "mixed_moves", "kind": "line_count", "cell": "mixed_commit.stdout", "line_prefix": "move ", "expect": 2},
    {"action": "claim", "name": "mixed_replaces", "kind": "line_count", "cell": "mixed_commit.stdout", "line_prefix": "replace ", "expect": 1},
    {"action": "file_equals", "path": "$work/mixed/repo/a.pl", "text": ":- module(a, [check/0]).\n:- use_module('lib/b').\n\ncheck :- true.\n", "capture": "mixed_prolog_untouched"},
    {"action": "file_equals", "path": "$work/mixed/repo/src/user.ts", "text": "import { x } from './deep/x';\n\nexport const user = x;\n", "capture": "mixed_user_respelled"},

    {"action": "write", "path": "$work/collide/repo/src/a.ts", "text": "export const a = 'a';\n"},
    {"action": "write", "path": "$work/collide/repo/src/b.ts", "text": "export const b = 'b';\n"},
    {"action": "write", "path": "$work/collide/repo/src/c.ts", "text": "export const c = 'c';\n"},
    {"action": "write", "path": "$work/collide/repo/src/hub.ts", "text": "import { a } from './a';\nimport { b } from './b';\nimport { c } from './c';\n\nexport const hub = [a, b, c];\n"},
    {"action": "write", "path": "$work/collide/repo/src/onlyA.ts", "text": "import { a } from './a';\n\nexport const onlyA = a;\n"},
    {"action": "directory", "path": "$work/collide/state"},
    {"action": "git", "args": ["init", "-q", "."], "cwd": "$work/collide/repo"},
    {"action": "git", "args": ["add", "-A"], "cwd": "$work/collide/repo"},
    {"action": "git", "args": ["-c", "user.email=extract@move.test", "-c", "user.name=extract-move", "commit", "-qm", "fixture"], "cwd": "$work/collide/repo"},
    {"action": "write", "path": "$work/collide/state/moves.tsv", "text": "src/a.ts\tsrc/b2.ts\nsrc/b.ts\tsrc/a.ts\n"},
    {"action": "command", "arguments": ["move", "--list", "$work/collide/state/moves.tsv", "--root", "$work/collide/repo", "--state", "$work/collide/state"], "cwd": "$work/collide/repo", "success": false, "capture": "collide_refusal"},
    {"action": "claim", "name": "collide_message", "kind": "line_matches", "cell": "collide_refusal.stderr", "texts": ["move destination already exists", "src/a.ts"], "expect": true},
    {"action": "command", "program": "git", "arguments": ["status", "--porcelain"], "cwd": "$work/collide/repo", "raw_stdout": true, "capture": "collide_status"},
    {"action": "claim", "name": "collide_tree_clean", "kind": "text_equals", "cell": "collide_status.stdout", "text": ""},

    {"action": "write", "path": "$work/dupdest/repo/src/a.ts", "text": "export const a = 'a';\n"},
    {"action": "write", "path": "$work/dupdest/repo/src/b.ts", "text": "export const b = 'b';\n"},
    {"action": "write", "path": "$work/dupdest/repo/src/c.ts", "text": "export const c = 'c';\n"},
    {"action": "write", "path": "$work/dupdest/repo/src/hub.ts", "text": "import { a } from './a';\nimport { b } from './b';\nimport { c } from './c';\n\nexport const hub = [a, b, c];\n"},
    {"action": "write", "path": "$work/dupdest/repo/src/onlyA.ts", "text": "import { a } from './a';\n\nexport const onlyA = a;\n"},
    {"action": "directory", "path": "$work/dupdest/state"},
    {"action": "git", "args": ["init", "-q", "."], "cwd": "$work/dupdest/repo"},
    {"action": "git", "args": ["add", "-A"], "cwd": "$work/dupdest/repo"},
    {"action": "git", "args": ["-c", "user.email=extract@move.test", "-c", "user.name=extract-move", "commit", "-qm", "fixture"], "cwd": "$work/dupdest/repo"},
    {"action": "write", "path": "$work/dupdest/state/moves.tsv", "text": "src/a.ts\tlib/x.ts\nsrc/b.ts\tlib/x.ts\n"},
    {"action": "command", "arguments": ["move", "--list", "$work/dupdest/state/moves.tsv", "--root", "$work/dupdest/repo", "--state", "$work/dupdest/state"], "cwd": "$work/dupdest/repo", "success": false, "capture": "dupdest_refusal"},
    {"action": "claim", "name": "dupdest_message", "kind": "contains", "cell": "dupdest_refusal.stderr", "text": "destination of two moves"},
    {"action": "command", "program": "git", "arguments": ["status", "--porcelain"], "cwd": "$work/dupdest/repo", "raw_stdout": true, "capture": "dupdest_status"},
    {"action": "claim", "name": "dupdest_tree_clean", "kind": "text_equals", "cell": "dupdest_status.stdout", "text": ""},

    {"action": "write", "path": "$work/notab/repo/src/a.ts", "text": "export const a = 'a';\n"},
    {"action": "write", "path": "$work/notab/repo/src/b.ts", "text": "export const b = 'b';\n"},
    {"action": "write", "path": "$work/notab/repo/src/c.ts", "text": "export const c = 'c';\n"},
    {"action": "write", "path": "$work/notab/repo/src/hub.ts", "text": "import { a } from './a';\nimport { b } from './b';\nimport { c } from './c';\n\nexport const hub = [a, b, c];\n"},
    {"action": "write", "path": "$work/notab/repo/src/onlyA.ts", "text": "import { a } from './a';\n\nexport const onlyA = a;\n"},
    {"action": "directory", "path": "$work/notab/state"},
    {"action": "git", "args": ["init", "-q", "."], "cwd": "$work/notab/repo"},
    {"action": "git", "args": ["add", "-A"], "cwd": "$work/notab/repo"},
    {"action": "git", "args": ["-c", "user.email=extract@move.test", "-c", "user.name=extract-move", "commit", "-qm", "fixture"], "cwd": "$work/notab/repo"},
    {"action": "write", "path": "$work/notab/state/moves.tsv", "text": "src/a.ts lib/a.ts\n"},
    {"action": "command", "arguments": ["move", "--list", "$work/notab/state/moves.tsv", "--root", "$work/notab/repo", "--state", "$work/notab/state"], "cwd": "$work/notab/repo", "success": false, "capture": "notab_refusal"},
    {"action": "claim", "name": "notab_message", "kind": "contains", "cell": "notab_refusal.stderr", "text": ":1: a move list row is"},

    {"action": "write", "path": "$work/both/repo/src/a.ts", "text": "export const a = 'a';\n"},
    {"action": "write", "path": "$work/both/repo/src/b.ts", "text": "export const b = 'b';\n"},
    {"action": "write", "path": "$work/both/repo/src/c.ts", "text": "export const c = 'c';\n"},
    {"action": "write", "path": "$work/both/repo/src/hub.ts", "text": "import { a } from './a';\nimport { b } from './b';\nimport { c } from './c';\n\nexport const hub = [a, b, c];\n"},
    {"action": "write", "path": "$work/both/repo/src/onlyA.ts", "text": "import { a } from './a';\n\nexport const onlyA = a;\n"},
    {"action": "directory", "path": "$work/both/state"},
    {"action": "git", "args": ["init", "-q", "."], "cwd": "$work/both/repo"},
    {"action": "git", "args": ["add", "-A"], "cwd": "$work/both/repo"},
    {"action": "git", "args": ["-c", "user.email=extract@move.test", "-c", "user.name=extract-move", "commit", "-qm", "fixture"], "cwd": "$work/both/repo"},
    {"action": "write", "path": "$work/both/state/moves.tsv", "text": "# three files leave src/ for lib/\n\nsrc/a.ts\tlib/a.ts\nsrc/b.ts\tlib/b.ts\nsrc/c.ts\tlib/c.ts\n"},
    {"action": "command", "arguments": ["move", "$work/both/repo/src/a.ts", "$work/both/repo/lib/a.ts", "--list", "$work/both/state/moves.tsv", "--root", "$work/both/repo", "--state", "$work/both/state"], "success": false, "capture": "both_refusal"},
    {"action": "claim", "name": "both_message", "kind": "contains", "cell": "both_refusal.stderr", "text": "--list cannot be combined with OLD NEW"},

    {"action": "api", "name": "stale_guard", "api": "stale_replace_guard", "root": "$work/stale/repo"}
  ]
}
