      "path": "$work/root/facts.db",
      "sql": "SELECT count(*) FROM line_start"
    },
    {
      "action": "sqlite_rows",
      "name": "max_line",
      "path": "$work/root/facts.db",
      "sql": "SELECT max(line) FROM span_lines"
    },
    {
      "action": "run",
      "name": "stdout",
      "arguments": [
        "--resolve",
        "--lines",
        "$work/root"
      ],
      "expect_exit_code": 0,
      "unasserted_stderr": true,
      "raw_stdout": true
    }
  ]
}
