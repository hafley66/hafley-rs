{
  "steps": [
    {
      "action": "copy",
      "source": "$fixtures/graph_ts/chain_c.ts",
      "path": "$work/chain_c.ts"
    },
    {
      "action": "copy",
      "source": "$fixtures/graph_ts/chain_d.ts",
      "path": "$work/chain_d.ts"
    },
    {
      "action": "run",
      "name": "declined",
      "arguments": [
        "graph",
        "--slow",
        "--from",
        "chainC",
        "--root",
        ".",
        "."
      ],
      "cwd": "$work",
      "environment": {
        "SPREFA_NODE": "$work/absent/node"
      },
      "unasserted_exit": true,
      "assert_success": false,
      "raw_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "tier_named",
      "kind": "contains",
      "cell": "declined.stderr",
      "text": "ryi slow: tier.tsrs declined"
    },
    {
      "action": "claim",
      "name": "no_output",
      "kind": "text_equals",
      "cell": "declined.stdout",
      "text": ""
    }
  ]
}
