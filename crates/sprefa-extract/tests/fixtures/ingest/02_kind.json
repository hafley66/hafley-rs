{
  "steps": [
    {
      "action": "run",
      "name": "ingest",
      "cwd": "$manifest",
      "stdin_file": "$fixtures/ingest/02_kind.jsonl",
      "raw_stdout": true,
      "unasserted_exit": true,
      "unasserted_stderr": false,
      "assert_success": false,
      "arguments": [
        "ingest",
        "/dev/stdin"
      ]
    },
    {
      "action": "claim",
      "name": "error_0",
      "kind": "contains",
      "cell": "ingest.stderr",
      "text": "position 4"
    },
    {
      "action": "claim",
      "name": "error_1",
      "kind": "contains",
      "cell": "ingest.stderr",
      "text": "int"
    }
  ]
}
