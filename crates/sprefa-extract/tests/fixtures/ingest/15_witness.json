{
  "steps": [
    {
      "action": "run",
      "name": "producer",
      "cwd": "$manifest",
      "raw_stdout": true,
      "stdout_to": "$work/produced.jsonl",
      "unasserted_exit": true,
      "unasserted_stderr": true,
      "assert_success": true,
      "arguments": [
        "--witness",
        "--kinds",
        "type",
        "tests/fixtures/resolve/0_caller.ts"
      ]
    },
    {
      "action": "run",
      "name": "ingest",
      "cwd": "$manifest",
      "stdin_file": "$work/produced.jsonl",
      "raw_stdout": true,
      "unasserted_exit": true,
      "unasserted_stderr": true,
      "assert_success": true,
      "arguments": [
        "ingest",
        "/dev/stdin"
      ]
    }
  ]
}
