{
  "test": "qualified_calls_reexports_and_relative_uses_survive_a_cleave",
  "source_range": "632-660",
  "fixture": {
    "group": "cleave_rust",
    "variant": "basic",
    "label": "qualified"
  },
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_rust/basic",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "write",
      "path": "$work/repo/src/lib.rs",
      "text": "pub mod app;\npub mod config;\npub mod log;\npub mod util;\n\npub use log::log_line;\nuse log::log_line as note;\n\npub fn target(raw: &str) -> String {\n    note(raw);\n    raw.to_string()\n}\n"
    },
    {
      "action": "write",
      "path": "$work/repo/src/app.rs",
      "text": "pub fn boot(dir: &str) -> String {\n    crate::target(dir)\n}\n"
    },
    {
      "action": "git",
      "args": [
        "add",
        "-A"
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "command",
      "program": "$ryii",
      "arguments": [
        "cleave",
        "src/lib.rs#target",
        "src/config.rs",
        "--commit",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "capture": "stdout_commit",
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/app.rs",
      "capture": "app_after"
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/lib.rs",
      "capture": "lib_after"
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/config.rs",
      "capture": "config_after"
    },
    {
      "action": "claim",
      "kind": "contains",
      "cell": "app_after",
      "text": "crate::config::target(dir)",
      "name": "app_call_respelled"
    },
    {
      "action": "claim",
      "kind": "contains",
      "cell": "lib_after",
      "text": "pub use log::log_line;",
      "name": "lib_keeps_public_reexport"
    },
    {
      "action": "claim",
      "kind": "any_contains",
      "cell": "config_after",
      "texts": [
        "use crate::log::log_line as note;",
        "crate::log"
      ],
      "name": "config_travels_relative_use"
    },
    {
      "action": "command",
      "program": "$cargo",
      "arguments": [
        "check",
        "--quiet",
        "--offline"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "KACHE_DISABLED": "1"
      },
      "expect_exit_code": 0,
      "capture": "cargo_check",
      "raw_stdout": true
    }
  ]
}
