{
  "test": "batch_keeps_every_row_source_parseable_while_composing",
  "source_range": "253-278",
  "fixture": {
    "group": "cleave_rust",
    "variant": "basic",
    "label": "batch-invalid-rust",
    "note": "root is replaced by a fresh copy of $manifest/../soopy before the run"
  },
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_rust/basic",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "copy_tree",
      "source": "$manifest/../soopy",
      "target": "$work/repo",
      "fresh": true
    },
    {
      "action": "write",
      "path": "$work/repo/Cargo.toml",
      "text": "[package]\nname = \"soopy\"\nversion = \"0.0.0\"\nedition = \"2021\"\nautotests = false\n"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "write",
      "path": "$work/state/batch.tsv",
      "text": "src/_1_pattern.rs#Pattern\tsrc/_1b_extract.rs\nsrc/_0a_durable_write.rs#DeviceSyncCounts\tsrc/_0b_counts.rs\n"
    },
    {
      "action": "command",
      "program": "$ryii",
      "arguments": [
        "cleave",
        "--list",
        "$work/state/batch.tsv",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "capture": "stdout_batch",
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "claim",
      "kind": "absent",
      "cell": "stdout_batch",
      "text": "cleave batch leaves invalid Rust",
      "name": "batch_no_invalid_rust_stop"
    }
  ]
}
