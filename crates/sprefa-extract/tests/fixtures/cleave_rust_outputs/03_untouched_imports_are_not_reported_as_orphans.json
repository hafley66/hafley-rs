{
  "test": "untouched_imports_are_not_reported_as_orphans",
  "source_range": "217-230",
  "fixture": {
    "group": "cleave_rust",
    "variant": "basic",
    "label": "orphan-noise"
  },
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_rust/basic",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "write",
      "path": "$work/repo/src/util.rs",
      "text": "use crate::config::Config;\nuse crate::log::Log;\n\npub fn target() -> Config { Config::new() }\npub fn untouched() -> Log { Log::new() }\n"
    },
    {
      "action": "command",
      "program": "$ryii",
      "arguments": [
        "cleave",
        "src/util.rs#target",
        "src/app.rs",
        "--json",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "capture": "stdout_plan",
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "claim",
      "kind": "json_column_absent",
      "cell": "stdout_plan",
      "line_prefix": "{",
      "pointer": "orphans",
      "column": "name",
      "value": "Log",
      "name": "orphans_exclude_log"
    }
  ]
}
