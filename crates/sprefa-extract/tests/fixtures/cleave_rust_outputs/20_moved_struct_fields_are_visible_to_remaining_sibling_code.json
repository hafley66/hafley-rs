{
  "test": "moved_struct_fields_are_visible_to_remaining_sibling_code",
  "source_range": "780-789",
  "fixture": {
    "group": "cleave_ratchet",
    "variant": "private_fields",
    "label": "private-fields"
  },
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_ratchet/private_fields",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "git",
      "args": [
        "add",
        "-A"
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "command",
      "program": "$ryii",
      "arguments": [
        "cleave",
        "src/source.rs#Packet",
        "src/dest.rs",
        "--slow",
        "--commit",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "capture": "stdout_commit",
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "command",
      "program": "$cargo",
      "arguments": [
        "check",
        "--quiet",
        "--offline"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "KACHE_DISABLED": "1"
      },
      "expect_exit_code": 0,
      "capture": "cargo_check",
      "raw_stdout": true
    }
  ]
}
