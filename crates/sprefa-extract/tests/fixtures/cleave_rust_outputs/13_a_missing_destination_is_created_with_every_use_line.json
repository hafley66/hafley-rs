{
  "test": "a_missing_destination_is_created_with_every_use_line",
  "source_range": "536-552",
  "fixture": {
    "group": "cleave_rust",
    "variant": "basic",
    "label": "create"
  },
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_rust/basic",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "write",
      "path": "$work/repo/src/lib.rs",
      "text": "pub mod app;\npub mod config;\npub mod loader;\npub mod log;\npub mod util;\n"
    },
    {
      "action": "command",
      "program": "$ryii",
      "arguments": [
        "cleave",
        "src/util.rs#load_config",
        "src/loader.rs",
        "--commit",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "capture": "stdout_commit",
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/lib.rs",
      "capture": "lib_after"
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/loader.rs",
      "capture": "loader_after"
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/app.rs",
      "capture": "app_after"
    },
    {
      "action": "claim",
      "kind": "contains",
      "cell": "lib_after",
      "text": "pub mod loader;",
      "name": "lib_declares_loader"
    },
    {
      "action": "claim",
      "kind": "line_count",
      "cell": "loader_after",
      "line_prefix": "use ",
      "expect": 3,
      "name": "loader_use_lines"
    },
    {
      "action": "claim",
      "kind": "contains",
      "cell": "app_after",
      "text": "use crate::loader::load_config;",
      "name": "app_imports_loader"
    },
    {
      "action": "command",
      "program": "$cargo",
      "arguments": [
        "check",
        "--quiet",
        "--offline"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "KACHE_DISABLED": "1"
      },
      "expect_exit_code": 0,
      "capture": "cargo_check",
      "raw_stdout": true
    }
  ]
}
