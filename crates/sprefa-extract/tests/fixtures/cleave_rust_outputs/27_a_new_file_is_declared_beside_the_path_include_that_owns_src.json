{
  "test": "a_new_file_is_declared_beside_the_path_include_that_owns_src",
  "source_range": "886-896",
  "fixture": {
    "group": "cleave_rust",
    "variant": "path_bin",
    "label": "path-bin"
  },
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_rust/path_bin",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "command",
      "program": "$ryii",
      "arguments": [
        "cleave",
        "src/shared.rs#count",
        "src/counting.rs",
        "--commit",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "capture": "stdout_commit",
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "command",
      "program": "$cargo",
      "arguments": [
        "check",
        "--quiet",
        "--offline",
        "--all-targets"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "KACHE_DISABLED": "1"
      },
      "expect_exit_code": 0,
      "capture": "cargo_check_all_targets",
      "raw_stdout": true
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/bin/tool.rs",
      "capture": "tool_after"
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/lib.rs",
      "capture": "lib_after"
    },
    {
      "action": "claim",
      "kind": "text_equals",
      "cell": "tool_after",
      "text": "#[path = \"../shared.rs\"]\nmod shared;\n#[path = \"../counting.rs\"] pub(crate) mod counting;\n\nfn main() {\n    println!(\"{}\", shared::total());\n}\n",
      "name": "tool_exact_content"
    },
    {
      "action": "claim",
      "kind": "text_equals",
      "cell": "lib_after",
      "text": "pub fn library() -> u32 {\n    0\n}\n",
      "name": "lib_exact_content"
    }
  ]
}
