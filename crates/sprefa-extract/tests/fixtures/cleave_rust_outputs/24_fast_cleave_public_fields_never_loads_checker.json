{
  "test": "fast_cleave_public_fields_never_loads_checker",
  "source_range": "836-851",
  "fixture": {
    "group": "cleave_ratchet",
    "variant": "private_fields",
    "label": "public-fast"
  },
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_ratchet/private_fields",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "replace",
      "path": "$work/repo/src/source.rs",
      "from": "{ value: u8 }",
      "to": "{ pub(crate) value: u8 }"
    },
    {
      "action": "git",
      "args": [
        "add",
        "-A"
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "command",
      "program": "$ryii",
      "arguments": [
        "cleave",
        "src/source.rs#Packet",
        "src/dest.rs",
        "--commit",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "capture": "stdout_commit",
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/dest.rs",
      "capture": "dest_after"
    },
    {
      "action": "claim",
      "kind": "contains",
      "cell": "dest_after",
      "text": "pub(crate) value",
      "name": "dest_keeps_crate_visibility"
    }
  ]
}
