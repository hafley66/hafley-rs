{
  "test": "body_locals_never_enter_the_drag_set_or_gain_visibility",
  "source_range": "160-183",
  "fixture": {
    "group": "cleave_rust",
    "variant": "basic",
    "label": "body-locals"
  },
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_rust/basic",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "write",
      "path": "$work/repo/src/util.rs",
      "text": "pub fn target(value: i32) -> i32 {\n    let start = helper(value);\n    start\n}\npub(crate) fn helper(value: i32) -> i32 { value + 1 }\npub fn other(value: i32) -> i32 { helper(value) }\n"
    },
    {
      "action": "command",
      "program": "$ryii",
      "arguments": [
        "cleave",
        "src/util.rs#target",
        "src/config.rs",
        "--drag",
        "--json",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "capture": "stdout_drag",
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "claim",
      "kind": "json_column",
      "cell": "stdout_drag",
      "line_prefix": "{",
      "pointer": "dragged",
      "column": "name",
      "expect": [
        "helper"
      ],
      "name": "dragged_names"
    },
    {
      "action": "claim",
      "kind": "json_column",
      "cell": "stdout_drag",
      "line_prefix": "{",
      "pointer": "dragged",
      "column": "action",
      "expect": [
        "exported"
      ],
      "name": "dragged_actions"
    },
    {
      "action": "claim",
      "kind": "absent",
      "cell": "stdout_drag",
      "text": "pub let start",
      "name": "no_body_local_visibility"
    },
    {
      "action": "claim",
      "kind": "absent",
      "cell": "stdout_drag",
      "text": "pub pub(crate)",
      "name": "no_double_visibility"
    }
  ]
}
