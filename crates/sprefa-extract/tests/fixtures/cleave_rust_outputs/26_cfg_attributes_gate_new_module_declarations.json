{
  "test": "cfg_attributes_gate_new_module_declarations",
  "source_range": "866-884",
  "fixture": {
    "group": "cleave_ratchet",
    "variant": "cfg_new_module",
    "label": "cfg-new-module"
  },
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_ratchet/cfg_new_module",
      "target": "$work/repo"
    },
    {
      "action": "directory",
      "path": "$work/state"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "git",
      "args": [
        "add",
        "-A"
      ],
      "cwd": "$work/repo"
    },
    {
      "action": "command",
      "program": "$ryii",
      "arguments": [
        "cleave",
        "src/source.rs#target",
        "src/dest.rs",
        "--commit",
        "--root",
        "$work/repo",
        "--state",
        "$work/state"
      ],
      "cwd": "$work/repo",
      "environment": {
        "HAFLEY_TRACE": "$work/cleave.json",
        "RUST_LOG": "sprefa_extract=debug,hafley_scm=debug"
      },
      "expect_exit_code": 0,
      "capture": "stdout_commit",
      "raw_stdout": true,
      "unasserted_stderr": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "read_tree",
      "path": "$work/repo/src/lib.rs",
      "capture": "lib_after"
    },
    {
      "action": "claim",
      "kind": "contains",
      "cell": "lib_after",
      "text": "#[cfg_attr(\n    feature = \"checker\",\n    cfg(feature = \"checker\")\n)]\n#[cfg(feature = \"checker\")]\npub mod dest;",
      "name": "lib_gated_module_exact"
    },
    {
      "action": "command",
      "program": "$cargo",
      "arguments": [
        "check",
        "--quiet",
        "--offline",
        "--no-default-features"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "KACHE_DISABLED": "1"
      },
      "expect_exit_code": 0,
      "capture": "cargo_check_off",
      "raw_stdout": true
    },
    {
      "action": "command",
      "program": "$cargo",
      "arguments": [
        "check",
        "--quiet",
        "--offline",
        "--no-default-features",
        "--features",
        "checker"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "KACHE_DISABLED": "1"
      },
      "expect_exit_code": 0,
      "capture": "cargo_check_checker",
      "raw_stdout": true
    }
  ]
}
