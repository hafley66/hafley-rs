            {
              "text": "{\n  readonly id: T;\n  name?: string;\n  label: string;\n  seed: T;\n\n  constructor(id: T, label: string, seed: T) {\n    this.id = id;\n    this.label = label;\n    this.seed = seed;\n  }\n\n  map<U>(project: (element: T) => U): U {\n    return project(this.id);\n  }\n}"
            }
          ]
