{
  "steps": [
    {
      "source": "$fixtures/rust_rename/field_abstain/before",
      "target": "$work/repo",
      "action": "copy_tree"
    },
    {
      "path": "$work/state",
      "action": "directory"
    },
    {
      "action": "run",
      "name": "rename",
      "arguments": [
        "rename",
        "src/util.rs#size",
        "width",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--json"
      ],
      "cwd": "$work/repo",
      "expect_exit_code": 7,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "claim",
      "name": "claim_1",
      "cell": "rename.stdout",
      "kind": "contains",
      "text": "plan src/util.rs size -> width"
    },
    {
      "action": "claim",
      "name": "claim_2",
      "cell": "rename.stdout",
      "kind": "contains",
      "text": "src/lib.rs  1 uses"
    },
    {
      "action": "claim",
      "name": "claim_3",
      "cell": "rename.stdout",
      "kind": "contains",
      "text": "\"symbol\":\"size\",\"reason\":\"needs_types\",\"receiver\":\"v\""
    },
    {
      "action": "claim",
      "name": "claim_4",
      "cell": "rename.stderr",
      "kind": "text_equals",
      "text": ""
    },
    {
      "action": "tree_matches",
      "name": "claim_5",
      "left": "$work/repo",
      "fixture": "$fixtures/rust_rename/field_abstain/before"
    }
  ],
  "old_assertions": [
    {
      "cell": "exit_code",
      "kind": "code",
      "value": 7,
      "claim": "plan plus abstain exits 7"
    },
    {
      "cell": "stdout",
      "kind": "contains",
      "value": "plan src/util.rs size -> width",
      "claim": "plan is emitted"
    },
    {
      "cell": "stdout",
      "kind": "contains",
      "value": "src/lib.rs  1 uses",
      "claim": "typed access is planned"
    },
    {
      "cell": "stdout",
      "kind": "contains",
      "value": "\"symbol\":\"size\",\"reason\":\"needs_types\",\"receiver\":\"v\"",
      "claim": "untyped receiver is reported with its expression; JSON row"
    },
    {
      "cell": "stderr",
      "kind": "empty",
      "value": "",
      "claim": "abstain is not a run error"
    },
    {
      "cell": "tree_vs_before",
      "kind": "diff_rq_empty",
      "value": "diff -rq $work/repo <before>",
      "claim": "dry run edits nothing"
    }
  ],
  "notes": [
    "no --commit; --json output form",
    "old exit assertion message: 'plan plus abstain exits 7'"
  ]
}
