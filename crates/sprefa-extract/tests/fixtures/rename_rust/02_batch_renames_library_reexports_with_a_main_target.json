{
  "steps": [
    {
      "source": "$fixtures/rust_rename/reexport_batch/before",
      "target": "$work/repo",
      "action": "copy_tree"
    },
    {
      "path": "$work/state",
      "action": "directory"
    },
    {
      "path": "$work/state/batch.tsv",
      "text": "src/_1_pattern.rs\tPattern\tGlobPattern\nsrc/_0_types.rs\tRepositoryId\tRepoIdentity\n",
      "action": "write"
    },
    {
      "action": "run",
      "name": "rename",
      "arguments": [
        "rename",
        "--list",
        "$work/state/batch.tsv",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "cwd": "$work/repo",
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "tree_matches",
      "name": "claim_1",
      "left": "$work/repo",
      "fixture": "$fixtures/rust_rename/reexport_batch/after"
    }
  ],
  "old_assertions": [
    {
      "cell": "exit_code",
      "kind": "success",
      "value": 0,
      "claim": "batch run succeeds (stderr only in panic message)"
    },
    {
      "cell": "tree_vs_after",
      "kind": "diff_rq_eq_empty",
      "value": "diff -rq $work/repo <after> == []",
      "claim": "both rows land: re-export crossings plus main.rs consumer follow the names"
    }
  ],
  "notes": [
    "old assertion is assert_eq!(diff_rq(..), Vec::<String>::new()) - exact empty vec"
  ]
}
