{
  "steps": [
    {
      "source": "$fixtures/rust_rename/local/before",
      "target": "$work/repo",
      "action": "copy_tree"
    },
    {
      "path": "$work/state",
      "action": "directory"
    },
    {
      "action": "run",
      "name": "rename",
      "arguments": [
        "rename",
        "src/util.rs#Helper",
        "Tool",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "cwd": "$work/repo",
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "claim",
      "name": "claim_0",
      "cell": "rename.stdout",
      "kind": "contains",
      "text": "plan src/util.rs Helper -> Tool"
    },
    {
      "action": "claim",
      "name": "claim_1",
      "cell": "rename.stdout",
      "kind": "contains",
      "text": "  src/lib.rs  5 uses"
    },
    {
      "action": "claim",
      "name": "claim_2",
      "cell": "rename.stdout",
      "kind": "contains",
      "text": "  src/util.rs  4 uses"
    },
    {
      "action": "tree_matches",
      "name": "claim_3",
      "left": "$work/repo",
      "fixture": "$fixtures/rust_rename/local/after"
    }
  ],
  "old_assertions": [
    {
      "cell": "stdout",
      "kind": "contains",
      "value": "plan src/util.rs Helper -> Tool",
      "claim": "plan header names anchor file, old and new ident"
    },
    {
      "cell": "stdout",
      "kind": "contains",
      "value": "  src/lib.rs  5 uses",
      "claim": "lib.rs seat count"
    },
    {
      "cell": "stdout",
      "kind": "contains",
      "value": "  src/util.rs  4 uses",
      "claim": "util.rs seat count"
    },
    {
      "cell": "tree_vs_after",
      "kind": "diff_rq_empty",
      "value": "diff -rq $work/repo <after>",
      "claim": "committed tree equals hand-written after/ byte for byte (pins what stays: format!(\"Helper\") string, mod other struct, H alias body uses)"
    }
  ],
  "notes": [
    "ANCHOR const = src/util.rs",
    "helper rename_verb asserts success with stderr in the panic message"
  ]
}
