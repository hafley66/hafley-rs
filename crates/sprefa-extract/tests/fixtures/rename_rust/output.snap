  "07_macro_body_paths_rename_and_locals_stay": {
    "claim_0": {
      "files": {
        "Cargo.toml": "[package]\nname = \"rust-rename-macro\"\nversion = \"0.1.0\"\nedition = \"2021\"\n",
        "src/": {
          "directory": true
        },
        "src/_1b_ground.rs": "pub fn decide() -> u8 {\n    128\n}\n",
        "src/advance.rs": "use crate::_1b_ground::{self};\n\npub fn stepped() -> u8 {\n    _1b_ground::decide()\n}\n",
        "src/lib.rs": "pub mod _1b_ground;\n\npub mod advance;\npub mod status;\n\nmacro_rules! check {\n    ($value:expr) => { $value };\n}\n\npub struct Inventory {\n    pub ground: u8,\n}\n\npub fn run(inventory: &Inventory) -> u8 {\n    let ground = \"ground\";\n    let stepped = check!(_1b_ground::decide());\n    let field = check!(inventory.ground);\n    let named = check!(ground);\n    let _ = ground;\n    let _ = named;\n    stepped + field\n}\n\npub fn tally(steps: &[u8]) -> u8 {\n    let mut total = 0;\n    for ground in steps {\n        total += check!(*ground);\n    }\n    total\n}\n",
        "src/status.rs": "use crate::{Inventory, _1b_ground};\n\npub fn total(inventory: &Inventory) -> u8 {\n    inventory.ground + _1b_ground::decide()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn decides() {\n        assert_eq!(_1b_ground::decide(), 128);\n    }\n}\n",
        "src/twins.rs": "pub struct Wyll;\n\npub struct Wyll;\n"
      }
    },
    "rename": {
      "exit_code": 0,
      "stdout": "root $work/repo\nplan src/lib.rs ground -> _1b_ground\n  src/advance.rs  2 uses\n  src/lib.rs  2 uses\n  src/status.rs  3 uses\nreplace src/advance.rs -> src/advance.rs  update src/advance.rs (84 bytes)\n    --- original\n    +++ modified\n    @@ -1,5 +1,5 @@\n    -use crate::ground::{self};\n    +use crate::_1b_ground::{self};\n    \n     pub fn stepped() -> u8 {\n    -    ground::decide()\n    +    _1b_ground::decide()\n     }\nreplace src/lib.rs -> src/lib.rs  update src/lib.rs (547 bytes)\n    --- original\n    +++ modified\n    @@ -1,5 +1,4 @@\n    -#[path = \"_1b_ground.rs\"]\n    -pub mod ground;\n    +pub mod _1b_ground;\n    \n     pub mod advance;\n     pub mod status;\n    @@ -14,7 +13,7 @@\n    \n     pub fn run(inventory: &Inventory) -> u8 {\n         let ground = \"ground\";\n    -    let stepped = check!(ground::decide());\n    +    let stepped = check!(_1b_ground::decide());\n         let field = check!(inventory.ground);\n         let named = check!(ground);\n         let _ = ground;\nreplace src/status.rs -> src/status.rs  update src/status.rs (258 bytes)\n    --- original\n    +++ modified\n    @@ -1,7 +1,7 @@\n    -use crate::{Inventory, ground};\n    +use crate::{Inventory, _1b_ground};\n    \n     pub fn total(inventory: &Inventory) -> u8 {\n    -    inventory.ground + ground::decide()\n    +    inventory.ground + _1b_ground::decide()\n     }\n    \n     #[cfg(test)]\n    @@ -10,6 +10,6 @@\n    \n         #[test]\n         fn decides() {\n    -        assert_eq!(ground::decide(), 128);\n    +        assert_eq!(_1b_ground::decide(), 128);\n         }\n     }\nstage $STAGE committed\n",
