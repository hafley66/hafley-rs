{
  "steps": [
    {
      "source": "$fixtures/rust_rename/macro/before",
      "target": "$work/repo",
      "action": "copy_tree"
    },
    {
      "path": "$work/state",
      "action": "directory"
    },
    {
      "action": "run",
      "name": "rename",
      "arguments": [
        "rename",
        "src/lib.rs#ground",
        "_1b_ground",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "cwd": "$work/repo",
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "run",
      "name": "cargo",
      "arguments": [
        "check",
        "--offline"
      ],
      "cwd": "$work/repo",
      "expect_exit_code": 0,
      "raw_stdout": true,
      "program": "$cargo",
      "unasserted_stderr": true,
      "unasserted_stdout": true,
      "environment": {
        "CARGO_TARGET_DIR": "$work/repo/target"
      }
    }
  ],
  "old_assertions": [
    {
      "cell": "exit_code(cargo)",
      "kind": "success",
      "value": 0,
      "claim": "the module declared through #[path = \"_1b_ground.rs\"] still compiles once the ident moves"
    }
  ],
  "notes": [
    "cargo stdout/stderr unpinned in the old test"
  ]
}
