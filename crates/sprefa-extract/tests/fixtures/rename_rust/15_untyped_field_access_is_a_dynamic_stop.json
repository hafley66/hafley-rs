{
  "steps": [
    {
      "source": "$fixtures/rust_rename/field_stop/before",
      "target": "$work/repo",
      "action": "copy_tree"
    },
    {
      "path": "$work/state",
      "action": "directory"
    },
    {
      "action": "run",
      "name": "rename",
      "arguments": [
        "rename",
        "src/util.rs#size",
        "width",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "cwd": "$work/repo",
      "expect_exit_code": 6,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "claim",
      "name": "claim_1",
      "cell": "rename.stderr",
      "kind": "contains",
      "text": "untyped field"
    },
    {
      "action": "claim",
      "name": "claim_2",
      "cell": "rename.stderr",
      "kind": "line_count",
      "line_prefix": "",
      "expect": 1
    },
    {
      "action": "tree_matches",
      "name": "claim_3",
      "left": "$work/repo",
      "fixture": "$fixtures/rust_rename/field_stop/before"
    }
  ],
  "old_assertions": [
    {
      "cell": "exit_code",
      "kind": "code",
      "value": 6,
      "claim": "Dynamic exits 6"
    },
    {
      "cell": "stderr",
      "kind": "contains",
      "value": "untyped field",
      "claim": "the stop names the form"
    },
    {
      "cell": "stderr",
      "kind": "line_count",
      "value": 1,
      "claim": "one seat, one line"
    },
    {
      "cell": "tree_vs_before",
      "kind": "diff_rq_empty",
      "value": "diff -rq $work/repo <before>",
      "claim": "tree untouched; let v = make() with make in another file sits outside the one-hop same-file return-type rule, receiver types Unknown"
    }
  ],
  "notes": []
}
