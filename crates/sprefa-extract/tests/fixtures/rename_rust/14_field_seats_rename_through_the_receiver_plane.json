{
  "steps": [
    {
      "source": "$fixtures/rust_rename/field/before",
      "target": "$work/repo",
      "action": "copy_tree"
    },
    {
      "path": "$work/state",
      "action": "directory"
    },
    {
      "action": "run",
      "name": "rename",
      "arguments": [
        "rename",
        "src/util.rs#size",
        "width",
        "--at",
        "28",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "cwd": "$work/repo",
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "tree_matches",
      "name": "claim_0",
      "left": "$work/repo",
      "fixture": "$fixtures/rust_rename/field/after"
    }
  ],
  "old_assertions": [
    {
      "cell": "tree_vs_after",
      "kind": "diff_rq_empty",
      "value": "diff -rq $work/repo <after>",
      "claim": "decl, self.size in impl method, h.size typed off param annotation, struct-literal key, and destructuring-pattern key rename (pattern respells shorthand size -> width: size so the local binding keeps its name); Other.size and the &Other-typed param stay"
    }
  ],
  "notes": [
    "--at value derived at runtime in the old test via text.find(\"size\") on committed before/src/util.rs; pinned here as 28 (manifest derived_constants.field_at_bytes)"
  ]
}
