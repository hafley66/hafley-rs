{
  "steps": [
    {
      "source": "$fixtures/rust_rename/local/before",
      "target": "$work/repo",
      "action": "copy_tree"
    },
    {
      "path": "$work/state",
      "action": "directory"
    },
    {
      "action": "run",
      "name": "rename",
      "arguments": [
        "rename",
        "src/util.rs#Helper",
        "Tool",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "cwd": "$work/repo",
      "expect_exit_code": 0,
      "raw_stdout": true,
      "stdout_redactions": [
        {
          "pattern": "(?m)^(stage )[0-9a-f]{64}( committed| dry run, tree untouched)$",
          "replacement": "${1}$$STAGE${2}"
        }
      ]
    },
    {
      "action": "run",
      "name": "cargo",
      "arguments": [
        "check",
        "--offline"
      ],
      "cwd": "$work/repo",
      "expect_exit_code": 0,
      "raw_stdout": true,
      "program": "$cargo",
      "unasserted_stderr": true,
      "unasserted_stdout": true,
      "environment": {
        "CARGO_TARGET_DIR": "$work/repo/target"
      }
    }
  ],
  "old_assertions": [
    {
      "cell": "exit_code",
      "kind": "success",
      "value": 0,
      "claim": "rustc judges the renamed fixture crate: cargo check on the committed tree exits 0 (crate has no dependencies, so the check is the fixture's own two files and nothing else)"
    }
  ],
  "notes": [
    "cargo stdout/stderr unpinned in the old test; only status.success() is asserted"
  ]
}
