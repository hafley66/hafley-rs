          "relation": "tsi.name",
          "args": [
            {
              "id": 31
            },
            {
              "text": "{\n  constructor(public x: number, public y: number) {}\n  magnitude(): number {\n    return Math.sqrt(this.x * this.x + this.y * this.y);\n  }\n  // method with a named-type param + return.\n  scaled(by: Vec): Vec2 {\n    return new Vec2(this.x, this.y);\n  }\n}"
            }
          ]
        },
        {
          "record": "fact",
          "fact": 111,
          "relation": "tsi.name",
          "args": [
