              "integer": 107
            },
            {
              "text": "tsi.name"
            },
            {
              "text": "[{\"id\":28},{\"text\":\"{\\n  function clamp(n: number): number {\\n    return n;\\n  }\\n  return new Vec2(clamp(p.x), clamp(p.y));\\n}\"}]"
            }
