{
  "claim_test": "foreign_witness_stream_is_preserved_and_bad_ingest_is_atomic",
  "steps": [
    {"action": "directory", "path": "$work/07"},
    {
      "action": "run", "name": "witness",
      "arguments": ["--witness", "tests/fixtures/ts/sample.ts"],
      "stdout_to": "$work/07/stream.jsonl", "success": true
    },
    {
      "action": "run", "name": "ingest_plain",
      "arguments": ["ingest", "$work/07/stream.jsonl"],
      "stdout_to": "$work/07/ingested.jsonl", "success": true
    },
    {
      "action": "run", "name": "ingest_export",
      "arguments": ["ingest", "$work/07/stream.jsonl", "--sqlite", "$work/07/foreign.db"],
      "raw_stdout": true, "success": true
    },
    {
      "action": "api", "name": "match", "api": "jsonl_matches",
      "database": "$work/07/foreign.db", "jsonl": "$work/07/ingested.jsonl", "mode": "exact"
    },
    {
      "action": "write", "path": "$work/07/stream.jsonl",
      "text": "not JSON\n"
    },
    {
      "action": "run", "name": "ingest_bad",
      "arguments": ["ingest", "$work/07/stream.jsonl", "--sqlite", "$work/07/bad.db"],
      "success": false
    },
    {"action": "exists", "name": "bad_db_absent", "path": "$work/07/bad.db", "expected": false},
    {"action": "absent_prefix", "name": "no_staging_leftovers", "path": "$work/07", "prefix": ".extract-sqlite-"}
  ]
}
