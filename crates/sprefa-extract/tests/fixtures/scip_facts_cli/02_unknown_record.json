{
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/scip_rel",
      "target": "$work/tests/fixtures/scip_rel"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work"
    },
    {
      "action": "git",
      "args": [
        "add",
        "tests"
      ],
      "cwd": "$work"
    },
    {
      "action": "run",
      "name": "error",
      "arguments": [
        "scip",
        "--raw",
        "--records",
        "scip_occurrances",
        "--root",
        "tests/fixtures/scip_rel",
        "--scip-build",
        "tests/fixtures/scip_rel/animal.ts"
      ],
      "cwd": "$work",
      "assert_success": false,
      "unasserted_exit": true,
      "unasserted_stderr": false,
      "raw_stdout": true
    },
    {
      "action": "claim",
      "name": "typo",
      "kind": "contains",
      "cell": "error.stderr",
      "text": "scip_occurrances"
    },
    {
      "action": "claim",
      "name": "known",
      "kind": "contains",
      "cell": "error.stderr",
      "text": "scip_occurrence"
    }
  ]
}
