{
  "steps": [
    {
      "action": "copy",
      "source": "$fixtures/scip_facts_cli/empty.ts",
      "path": "$work/empty.ts"
    },
    {
      "action": "run",
      "name": "file",
      "arguments": [
        "--file-fact",
        "--kinds",
        "cst",
        "$work/empty.ts"
      ],
      "cwd": "$work",
      "assert_success": true,
      "unasserted_exit": true,
      "unasserted_stderr": true,
      "raw_stdout": true
    },
    {
      "action": "claim",
      "name": "size_lines",
      "kind": "line_matches",
      "cell": "file.stdout",
      "texts": [
        "\"bytes\":0,\"lines\":0"
      ]
    }
  ]
}
