      "src/_1_src.rs": "use crate::_0_base::{\n    Base,\n    Show,\n};\n\n/// Documented item.\n/// Second doc line.\n#[derive(Debug, Clone)]\npub struct Documented {\n    pub base: Base,\n}\n\npub struct Plain;\n\nimpl Show for Plain {\n    fn show(&self) -> u32 {\n        1\n    }\n}\n\npub fn keeps_using() -> u32 {\n    use crate::_0_base::Base as Local;\n    let _local = Local;\n    Plain.show()\n}\n",
