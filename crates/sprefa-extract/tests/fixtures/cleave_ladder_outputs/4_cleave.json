{
  "steps": [
    {
      "action": "copy_tree",
      "source": "$fixtures/cleave_ladder",
      "target": "$work/repo"
    },
    {
      "action": "git",
      "args": [
        "init",
        "-q",
        "."
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "RUST_LOG": "off",
        "KACHE_DISABLED": "1"
      }
    },
    {
      "action": "git",
      "args": [
        "add",
        "-A"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "RUST_LOG": "off",
        "KACHE_DISABLED": "1"
      }
    },
    {
      "action": "git",
      "args": [
        "-c",
        "user.email=l@l",
        "-c",
        "user.name=l",
        "commit",
        "-qm",
        "l"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "RUST_LOG": "off",
        "KACHE_DISABLED": "1"
      }
    },
    {
      "action": "run",
      "name": "cleave",
      "arguments": [
        "cleave",
        "--list",
        "$fixtures/cleave_ladder_outputs/inputs/glob.tsv",
        "--root",
        "$work/repo",
        "--state",
        "$work/state",
        "--commit"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "RUST_LOG": "off",
        "KACHE_DISABLED": "1"
      },
      "expect_exit_code": 0,
      "unasserted_stdout": true,
      "unasserted_stderr": true,
      "raw_stdout": true
    },
    {
      "action": "git",
      "args": [
        "add",
        "-A"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "RUST_LOG": "off",
        "KACHE_DISABLED": "1"
      },
      "unasserted_exit": true
    },
    {
      "action": "command",
      "name": "check",
      "program": "$cargo",
      "arguments": [
        "check",
        "--offline",
        "--all-targets",
        "-q",
        "--message-format",
        "short"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "RUST_LOG": "off",
        "KACHE_DISABLED": "1"
      },
      "expect_exit_code": 0,
      "unasserted_stdout": true,
      "unasserted_stderr": true,
      "raw_stdout": true
    },
    {
      "action": "command",
      "name": "diff",
      "program": "git",
      "arguments": [
        "diff",
        "--cached",
        "-U0",
        "--no-color",
        "--no-renames"
      ],
      "cwd": "$work/repo",
      "environment": {
        "CARGO_TARGET_DIR": "$work/target",
        "RUST_LOG": "off",
        "KACHE_DISABLED": "1"
      },
      "unasserted_exit": true,
      "raw_stdout": true,
      "unasserted_stderr": true
    },
    {
      "action": "claim",
      "name": "original_diff",
      "cell": "diff.stdout",
      "kind": "git_diff_lines",
      "expect": [
        "  src/_4_types.rs",
        "    -pub struct Span4 {",
        "    -    pub at: u32,",
        "    -}",
        "    -",
        "    -pub struct Req4 {",
        "    -    pub span: Span4,",
        "    -}",
        "    -",
        "    +use crate::_6_moved::Span4;",
        "  src/_5_user.rs",
        "    -    use crate::_4_types::{Req4, Span4};",
        "    +    use crate::_6_moved::Req4;",
        "    +    use crate::_6_moved::Span4;",
        "  src/_6_moved.rs",
        "    +pub struct Span4 {",
        "    +    pub at: u32,",
        "    +}",
        "    +",
        "    +pub struct Req4 {",
        "    +    pub span: Span4,",
        "    +}",
        "  src/lib.rs",
        "    +pub(crate) mod _6_moved;",
        "    +pub use crate::_6_moved::Req4;",
        "    +pub use crate::_6_moved::Span4;"
      ]
    },
    {
      "action": "read_tree",
      "name": "tree",
      "path": "$work/repo",
      "directory": true,
      "exclude_prefixes": [
        ".git/",
        "target/",
        "Cargo.lock",
        ".dl/"
      ]
    }
  ]
}
